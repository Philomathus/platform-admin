<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.ActivityTypeMapper">

    <resultMap type="ActivityType" id="ActivityTypeResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectActivityTypeVo">
        select id, name, create_by, create_time from activity_type
    </sql>

    <select id="selectActivityTypeList" parameterType="ActivityType" resultMap="ActivityTypeResult">
        <include refid="selectActivityTypeVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>

    <select id="selectActivityTypeById" parameterType="String" resultMap="ActivityTypeResult">
        <include refid="selectActivityTypeVo"/>
        where id = #{id}
    </select>

    <select id="selectActivityType" parameterType="ActivityType" resultMap="ActivityTypeResult">
        <include refid="selectActivityTypeVo"/>
    </select>

    <insert id="insertActivityType" parameterType="ActivityType">
        insert into activity_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateActivityType" parameterType="ActivityType">
        update activity_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteActivityTypeById" parameterType="String">
        delete from activity_type where id = #{id}
    </delete>

    <delete id="deleteActivityTypeByIds" parameterType="String">
        delete from activity_type where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
