<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.PayTypeMapper">
	<resultMap type="PayType" id="PayTypeResult">
		<result property="id" column="id"/>
		<result property="name" column="name"/>
		<result property="code" column="code"/>
		<result property="iconUrl" column="icon_url"/>
		<result property="indexes" column="indexes"/>
		<result property="isRecommend" column="is_recommend"/>
		<result property="status" column="status"/>
		<result property="isOnline" column="is_online"/>
		<result property="type" column="type"/>
		<result property="deviceType" column="device_type"/>
		<result property="creator" column="creator"/>
		<result property="createTime" column="create_time"/>
		<result property="updator" column="updator"/>
		<result property="updateTime" column="update_time"/>
		<result property="openLevel" column="open_level"/>
		<result property="tex1" column="tex1"/>
		<result property="tex2" column="tex2"/>
		<result property="tex3" column="tex3"/>
		<result property="tex4" column="tex4"/>
		<result property="tex5" column="tex5"/>
	</resultMap>

	<sql id="selectPayTypeVo">
		select id, name, code, icon_url, indexes, is_recommend, status, is_online, type, device_type, creator, create_time , updator,
		update_time , open_level,tex1,tex2,tex3,tex4,tex5 from ${dbMain}.pay_type
	</sql>

	<select id="selectPayTypeList" parameterType="PayType" resultMap="PayTypeResult">
		<include refid="selectPayTypeVo"/>
		<where>
			<if test="name != null  and name != ''">
				and name like concat('%', #{name}, '%')
			</if>
			<if test="code != null  and code != ''">
				and code = #{code}
			</if>
			<if test="iconUrl != null  and iconUrl != ''">
				and icon_url = #{iconUrl}
			</if>
			<if test="indexes != null">
				and indexes = #{indexes}
			</if>
			<if test="isRecommend != null">
				and is_recommend = #{isRecommend}
			</if>
			<if test="status != null and status != ''">
				and status = #{status}
			</if>
			<if test="isOnline != null">
				and is_online = #{isOnline}
			</if>
			<if test="type != null">
				and type = #{type}
			</if>
			<if test="deviceType != null and deviceType != ''">
				and device_type = #{deviceType}
			</if>
			<if test="creator != null  and creator != ''">
				and creator = #{creator}
			</if>
			<if test="updator != null  and updator != ''">
				and updator = #{updator}
			</if>
			<if test="openLevel != null">
				and open_level = #{openLevel}
			</if>
		</where>
	</select>

	<select id="selectPayTypeById" parameterType="String" resultMap="PayTypeResult">
		<include refid="selectPayTypeVo"/>
		where id = #{id}
	</select>

	<select id="existCode" parameterType="Integer" resultType="java.lang.Integer">
		select count(0) from ${dbMain}.pay_type
		where code = #{code}
	</select>

	<insert id="insertPayType" parameterType="PayType">
		insert into pay_type
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">
				id,
			</if>
			<if test="name != null and name != ''">
				name,
			</if>
			<if test="code != null and code != ''">
				code,
			</if>
			<if test="iconUrl != null">
				icon_url,
			</if>
			<if test="indexes != null">
				indexes,
			</if>
			<if test="isRecommend != null">
				is_recommend,
			</if>
			<if test="status != null and status != ''">
				status,
			</if>
			<if test="isOnline != null">
				is_online,
			</if>
			<if test="type != null">
				type,
			</if>
			<if test="deviceType != null and deviceType != ''">
				device_type,
			</if>
			<if test="creator != null">
				creator,
			</if>
			<if test="createTime != null">
				create_time,
			</if>
			<if test="updator != null">
				updator,
			</if>
			<if test="updateTime != null">
				update_time,
			</if>
			<if test="openLevel != null">
				open_level,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">
				#{id},
			</if>
			<if test="name != null and name != ''">
				#{name},
			</if>
			<if test="code != null and code != ''">
				#{code},
			</if>
			<if test="iconUrl != null">
				#{iconUrl},
			</if>
			<if test="indexes != null">
				#{indexes},
			</if>
			<if test="isRecommend != null">
				#{isRecommend},
			</if>
			<if test="status != null and status != ''">
				#{status},
			</if>
			<if test="isOnline != null">
				#{isOnline},
			</if>
			<if test="type != null">
				#{type},
			</if>
			<if test="deviceType != null and deviceType != ''">
				#{deviceType},
			</if>
			<if test="creator != null">
				#{creator},
			</if>
			<if test="createTime != null">
				#{createTime},
			</if>
			<if test="updator != null">
				#{updator},
			</if>
			<if test="updateTime != null">
				#{updateTime},
			</if>
			<if test="openLevel != null">
				#{openLevel},
			</if>
		</trim>
	</insert>

	<update id="updatePayType" parameterType="PayType">
		update ${dbMain}.pay_type
		<trim prefix="SET" suffixOverrides=",">
			<if test="name != null and name != ''">
				name = #{name},
			</if>
			<if test="iconUrl != null">
				icon_url = #{iconUrl},
			</if>
			<if test="indexes != null">
				indexes = #{indexes},
			</if>
			<if test="isRecommend != null">
				is_recommend = #{isRecommend},
			</if>
			<if test="status != null and status != ''">
				status = #{status},
			</if>
			<if test="isOnline != null">
				is_online = #{isOnline},
			</if>
			<if test="type != null">
				type = #{type},
			</if>
			<if test="deviceType != null and deviceType != ''">
				device_type = #{deviceType},
			</if>
			<if test="creator != null">
				creator = #{creator},
			</if>
			<if test="createTime != null">
				create_time = #{createTime},
			</if>
			<if test="updator != null">
				updator = #{updator},
			</if>
			<if test="updateTime != null">
				update_time = #{updateTime},
			</if>
			<if test="openLevel != null">
				open_level = #{openLevel},
			</if>
			<if test="tex1 != null and tex1 != ''">
				tex1 = #{tex1},
			</if>
			<if test="tex2 != null">
				tex2 = #{tex2},
			</if>
			<if test="tex3 != null">
				tex3 = #{tex3},
			</if>
			<if test="tex4 != null">
				tex4 = #{tex4},
			</if>
			<if test="tex5 != null">
				tex5 = #{tex5},
			</if>
		</trim>
		where id = #{id}
	</update>

	<delete id="deletePayTypeById" parameterType="String">
		delete
		from pay_type
		where id = #{id}
	</delete>

	<delete id="deletePayTypeByIds" parameterType="String">
		delete
		from pay_type where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

	<select id="selectCodeById" resultType="java.lang.Integer">
		select code
		from pay_type
		where id = #{id}
	</select>

	<select id="countByCode" resultType="int">
		select count(0)
		from pay_type
		where code = #{code}
	</select>

	<select id="selectCachePayTypeList" resultMap="PayTypeResult">
		<include refid="selectPayTypeVo"/>
		where (id in (select DISTINCT pay_type_id from pay_channel_new where `status` = '1'))
		   or (type in ('2', '3', '5') and `status` = '1')
		order by indexes
	</select>

	<select id="selectPayChannelNew" parameterType="String" resultType="java.lang.Integer">
		select count(0) from pay_channel_new where pay_type_id = #{id}
	</select>
</mapper>
