<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LotteryBet0Mapper">

    <resultMap type="LotteryBet0" id="LotteryBet0Result">
        <result property="id"    column="id"    />
        <result property="lotteryId"    column="lottery_id"    />
        <result property="puserId"    column="puser_id"    />
        <result property="issue"    column="issue"    />
        <result property="status"    column="status"    />
        <result property="methodId"    column="method_id"    />
        <result property="betSelect"    column="bet_select"    />
        <result property="betIds"    column="bet_ids"    />
        <result property="chip"    column="chip"    />
        <result property="prize"    column="prize"    />
        <result property="cost"    column="cost"    />
        <result property="lotteryName"    column="lottery_name"    />
        <result property="anchor"    column="anchor"    />
        <result property="code"    column="code"    />
        <result property="betTime"    column="bet_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectLotteryBet0Vo">
        select id, lottery_id, puser_id, issue, status, method_id, bet_select, bet_ids, chip, prize, cost, lottery_name, anchor, code, bet_time,  FROM_UNIXTIME(update_time) update_time from ${dbLottery}.lottery_bet_view
    </sql>

    <select id="selectLotteryBet0List" parameterType="LotteryBet0" resultMap="LotteryBet0Result">
        <include refid="selectLotteryBet0Vo"/>
        <where>
            <if test="lotteryId != null "> and lottery_id = #{lotteryId}</if>
            <if test="puserId != null  and puserId != ''"> and puser_id = #{puserId}</if>
            <if test="issue != null  and issue != ''"> and issue = #{issue}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="methodId != null  and methodId != ''"> and method_id = #{methodId}</if>
            <if test="betSelect != null  and betSelect != ''"> and bet_select = #{betSelect}</if>
            <if test="betIds != null  and betIds != ''"> and bet_ids = #{betIds}</if>
            <if test="chip != null "> and chip = #{chip}</if>
            <if test="prize != null "> and prize = #{prize}</if>
            <if test="cost != null "> and cost = #{cost}</if>
            <if test="lotteryName != null  and lotteryName != ''"> and lottery_name like concat('%', #{lotteryName}, '%')</if>
            <if test="anchor != null "> and anchor = #{anchor}</if>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and date_format(bet_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and date_format(bet_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
        </where>
    </select>
</mapper>
