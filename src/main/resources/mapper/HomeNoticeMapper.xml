<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.HomeNoticeMapper">
	<resultMap type="HomeNotice" id="HomeNoticeResult">
		<result property="id" column="id"/>
		<result property="title" column="title"/>
		<result property="content" column="content"/>
		<result property="updateTime" column="update_time"/>
		<result property="indexs" column="indexs"/>
		<result property="status" column="status"/>
		<result property="type" column="type"/>
	</resultMap>

	<sql id="selectHomeNoticeVo">
		select id, title, content, update_time, indexs, status, type
		from ${dbMain}.home_notice
	</sql>

	<select id="selectHomeNoticeList" parameterType="HomeNotice" resultMap="HomeNoticeResult">
		<include refid="selectHomeNoticeVo"/>
		<where>
			<if test="title != null  and title != ''">
				and title = #{title}
			</if>
			<if test="status != null">
				and status = #{status}
			</if>
			<if test="type != null">
				and type = #{type}
			</if>
		</where>
	</select>

	<select id="selectHomeNoticeById" parameterType="String" resultMap="HomeNoticeResult">
		<include refid="selectHomeNoticeVo"/>
		where id = #{id}
	</select>

	<insert id="insertHomeNotice" parameterType="HomeNotice">
		insert into ${dbMain}.home_notice
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">
				id,
			</if>
			<if test="title != null">
				title,
			</if>
			<if test="content != null">
				content,
			</if>
			<if test="updateTime != null">
				update_time,
			</if>
			<if test="indexs != null">
				indexs,
			</if>
			<if test="status != null">
				status,
			</if>
			<if test="type != null">
				type,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">
				#{id},
			</if>
			<if test="title != null">
				#{title},
			</if>
			<if test="content != null">
				#{content},
			</if>
			<if test="updateTime != null">
				#{updateTime},
			</if>
			<if test="indexs != null">
				#{indexs},
			</if>
			<if test="status != null">
				#{status},
			</if>
			<if test="type != null">
				#{type},
			</if>
		</trim>
	</insert>

	<update id="updateHomeNotice" parameterType="HomeNotice">
		update ${dbMain}.home_notice
		<trim prefix="SET" suffixOverrides=",">
			<if test="title != null">
				title = #{title},
			</if>

			<if test="content != null">
				content = #{content},
			</if>

			<if test="updateTime != null">
				update_time = #{updateTime},
			</if>

			<if test="indexs != null">
				indexs = #{indexs},
			</if>

			<if test="status != null">
				status = #{status},
			</if>

			<if test="type != null">
				type = #{type},
			</if>
		</trim>
		where id = #{id}
	</update>

	<delete id="deleteHomeNoticeById" parameterType="String">
		delete
		from ${dbMain}.home_notice
		where id = #{id}
	</delete>

	<delete id="deleteHomeNoticeByIds" parameterType="String">
		delete
		from ${dbMain}.home_notice where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>
</mapper>
