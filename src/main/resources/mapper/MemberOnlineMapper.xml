<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.MemberOnlineMapper">

    <resultMap type="MemberOnline" id="MemberOnlineResult">
        <result property="id"    column="id"    />
        <result property="onlineTime"    column="online_time"    />
    </resultMap>

    <sql id="selectMemberOnlineVo">
        select id, online_time from 7700_main.member_online
    </sql>

    <select id="selectMemberOnlineList" parameterType="MemberOnline" resultMap="MemberOnlineResult">
        select o.online_time,o.id,m.user_name userName,m.vip,m.nick_name nickName,m.login_ip loginIp from
        7700_main.member_online o left join 7700_main.member_info m on m.id = o.id
        where 1=1
            <if test="searchValue != null and searchValue != ''"> and (m.user_name = #{searchValue} or o.id = #{searchValue})</if>
            <if test="nickName != null and nickName != ''"> and m.nick_name = #{nickName}</if>
    </select>
</mapper>
