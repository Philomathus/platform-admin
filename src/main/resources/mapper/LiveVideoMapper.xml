    </sql>

	<sql id="selectLiveVideoVo">
        SELECT
			v.id,
			title,
			watch_number,
			cate_id,
			v.begin_time,
			room_type,
			sort,
			pai_id,
			is_recommend,
			live_fee,
			host_name,
			lottery_name,vote_Number,is_live_pay,s.name,live_image
		FROM
			cx_live.live_video v INNER JOIN cx_live.server_live s on(v.pai_id=s.id)
    </sql>

	<select id="selectLiveVideoList" parameterType="LiveVideo" resultMap="LiveVideoResult">
		<include refid="selectLiveVideoVo"/>
		<where>
			live_in = 1
			<if test="hostName != null  and title != ''">and host_name like CONCAT ('%',#{hostName,jdbcType=VARCHAR},'%') or
				v.id=#{hostName,jdbcType=VARCHAR}</if>
			<if test="cateId != null ">and cate_id = #{cateId}</if>
			<if test="paiId != null ">and pai_id = #{paiId}</if>
		</where>
	</select>

	<select id="selectLiveVideoById" parameterType="Long" resultMap="LiveVideoResultAll">
		<include refid="selectLiveVideoVoById"/>
