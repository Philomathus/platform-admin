    <select id="selectLiveVideoList2" parameterType="LiveVideo" resultMap="LiveVideoResult">
        <include refid="selectLiveVideoVo"/>
        <where>
            <if test="userId!= null">
                and v.user_id = #{userId}
            </if>
        </where>
    </select>

    <select id="selectExpiredVideo" resultType="java.lang.Long">
        select id from ${dbLive}.live_video
        where live_in = 0
        and (end_time is null or end_time <![CDATA[ <= ]]> DATE_SUB(NOW(), INTERVAL 5 HOUR))
        order by end_time desc
	</select>

    <select id="liveInStatus" resultMap="LiveVideoResult">
        select live_in from ${dbLive}.live_video where user_id = #{userId}
    </select>

    <select id="selectLiveVideoInIds" resultMap="LiveVideoResult">
        select id, host_name FROM ${dbLive}.live_video where id in
        <foreach collection="array" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>

    <select id="selectMainLiveInVideoList" resultMap="LiveVideoResult">
        SELECT * FROM ${dbMainLive}.live_video where live_in = 1 and id > 0;
    </select>

