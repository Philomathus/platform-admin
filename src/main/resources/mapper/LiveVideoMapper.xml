    <sql id="selectLiveVideoVo">
		SELECT
		v.id,
		v.user_id,
		v.group_id,
        v.live_in,
		title,
		watch_number,
		cate_id,
		begin_time,
		end_time,
		monitor_time,
		room_type,
		pai_id,
		sort,
		is_recommend,
		stick,
		live_fee,
		host_name,
		lottery_name,
		vote_Number,
		is_live_pay,
        is_concatvideo,
		s.name lineName,
		s.status lineStatus,
		live_image,
		play_url
		FROM
		${dbLive}.live_video v
		left join ${dbLive}.server_live s on(v.pai_id=s.id)
	</sql>

    <select id="selectLiveVideoList" parameterType="LiveVideo" resultMap="LiveVideoResult">
        <include refid="selectLiveVideoVo"/>
        where live_in = 1
        <if test="hostName != null  and hostName != ''">
            and (
            host_name like CONCAT('%', #{hostName,jdbcType=VARCHAR}, '%')
            or
            title = CONCAT('%', #{hostName,jdbcType=VARCHAR}, '%')
            )
        </if>
        <if test="paiId != null and paiId != ''">
            and pai_id = #{paiId}
        </if>
        <if test="id != null and id != ''">
            and v.id = #{id}
        </if>
        <if test="types != null and types.length != 0">
            and cate_id in
            <foreach item="id" collection="types" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        order by sort_init
    </select>

    <select id="selectLiveVideoById" parameterType="Long" resultMap="LiveVideoResult">
        <include refid="selectLiveVideoVo"/>
        where v.id = #{id}
    </select>

