<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.GameTypeMapper">

	<resultMap type="GameType" id="GameTypeResult">
		<result property="id" column="id"/>
		<result property="name" column="name"/>
		<result property="status" column="status"/>
		<result property="indexs" column="indexs"/>
		<result property="icon" column="icon"/>
		<result property="gameType" column="game_type"/>
		<result property="iconType" column="icon_type"/>
	</resultMap>

	<sql id="selectGameTypeVo">
		select id, name, status, indexs, icon, game_type, icon_type
		from game_type
	</sql>

	<select id="selectGameTypeName" resultType="com.qiqilm.server.admin.domain.GameType">
		select id, name from game_type
	</select>

	<select id="selectGameTypeList" resultType="com.qiqilm.server.admin.domain.GameType">
		select id, name, status, indexs, icon, game_type as gameType,icon_type as iconType from game_type
		<where>
			<if test="name != null  and name != ''">and name like concat('%', #{name}, '%')</if>
		</where>
	</select>

	<select id="selectGameTypeById" parameterType="String" resultMap="GameTypeResult">
		<include refid="selectGameTypeVo"/>
		where id = #{id}
	</select>

	<insert id="insertGameType" parameterType="GameType">
		insert into game_type
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="name != null">name,</if>
			<if test="status != null">status,</if>
			<if test="indexs != null">indexs,</if>
			<if test="icon != null">icon,</if>
			<if test="gameType != null">game_type,</if>
			<if test="iconType != null">icon_type,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="name != null">#{name},</if>
			<if test="status != null">#{status},</if>
			<if test="indexs != null">#{indexs},</if>
			<if test="icon != null">#{icon},</if>
			<if test="gameType != null">#{gameType},</if>
			<if test="iconType != null">#{iconType},</if>
		</trim>
	</insert>

	<update id="updateGameType" parameterType="GameType">
		update game_type
		<trim prefix="SET" suffixOverrides=",">
			<if test="name != null">name = #{name},</if>
			<if test="status != null">status = #{status},</if>
			<if test="indexs != null">indexs = #{indexs},</if>
			<if test="icon != null">icon = #{icon},</if>
			<if test="gameType != null">game_type = #{gameType},</if>
			<if test="iconType != null">icon_type = #{iconType},</if>
		</trim>
		where id = #{id}
	</update>

	<delete id="deleteGameTypeById" parameterType="String">
		delete from game_type where id = #{id}
	</delete>

	<delete id="deleteGameTypeByIds" parameterType="String">
		delete from game_type where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>
</mapper>