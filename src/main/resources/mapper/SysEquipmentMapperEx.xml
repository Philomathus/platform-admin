<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qiqilm.server.admin.mapper.SysEquipmentMapper" >


    <select id="findList" resultType="com.qiqilm.server.admin.rsp.RspEquipment">
        select *
        from sys_equipment
        where 1=1
        <if test="req.type != null ">
            and type = #{req.type}
        </if>
        <if test="req.eid != null and req.eid != ''">
            and eid = #{req.eid}
        </if>
        order by update_time desc
    </select>


</mapper>