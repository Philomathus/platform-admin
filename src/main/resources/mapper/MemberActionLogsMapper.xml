<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.MemberActionLogsMapper">
	<resultMap type="com.qiqilm.server.admin.domain.MemberActionLogs" id="MemberActionLogsResult">
		<result property="id" column="id"/>
		<result property="userId" column="user_id"/>
		<result property="userName" column="user_name"/>
		<result property="type" column="type"/>
		<result property="des" column="des"/>
		<result property="cTime" column="c_time"/>
		<result property="param1" column="param1"/>
		<result property="param2" column="param2"/>
		<result property="param3" column="param3"/>
		<result property="param4" column="param4"/>
		<result property="paramIp" column="param_ip"/>
	</resultMap>

	<sql id="selectMemberActionLogsVo">
		select id,
			   user_id,
			   user_name,
			   type,
			   des,
			   c_time,
			   param1,
			   param2,
			   param3,
			   param4,
			   param_ip
		from log_member_action
	</sql>

	<select id="selectMemberActionLogsList" parameterType="com.qiqilm.server.admin.domain.MemberActionLogs"
			resultMap="MemberActionLogsResult">
		<include refid="selectMemberActionLogsVo"/>
		<where>
			<if test="userId != null  and userId != ''">
				and user_id = #{userId}
			</if>
			<if test="userName != null  and userName != ''">
				and user_name like concat('%', #{userName}, '%')
			</if>
			<if test="type != null">
				and type = #{type}
			</if>
			<if test="des != null  and des != ''">
				and des = #{des}
			</if>
			<if test="cTime != null">
				and c_time = #{cTime}
			</if>
			<if test="param1 != null  and param1 != ''">
				and param1 = #{param1}
			</if>
			<if test="param2 != null  and param2 != ''">
				and param2 = #{param2}
			</if>
			<if test="param3 != null  and param3 != ''">
				and param3 = #{param3}
			</if>
			<if test="param4 != null  and param4 != ''">
				and param4 = #{param4}
			</if>
			<if test="paramIp != null  and paramIp != ''">
				and param_ip = #{paramIp}
			</if>
		</where>
	</select>

	<select id="selectMemberActionLogsById" parameterType="String" resultMap="MemberActionLogsResult">
		<include refid="selectMemberActionLogsVo"/>
		where id = #{id}
	</select>

	<insert id="insertMemberActionLogs" parameterType="com.qiqilm.server.admin.domain.MemberActionLogs">
		insert into log_member_action
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">
				id,
			</if>
			<if test="userId != null">
				user_id,
			</if>
			<if test="userName != null">
				user_name,
			</if>
			<if test="type != null">
				type,
			</if>
			<if test="des != null">
				des,
			</if>
			<if test="cTime != null">
				c_time,
			</if>
			<if test="param1 != null">
				param1,
			</if>
			<if test="param2 != null">
				param2,
			</if>
			<if test="param3 != null">
				param3,
			</if>
			<if test="param4 != null">
				param4,
			</if>
			<if test="paramIp != null">
				param_ip,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">
				#{id},
			</if>
			<if test="userId != null">
				#{userId},
			</if>
			<if test="userName != null">
				#{userName},
			</if>
			<if test="type != null">
				#{type},
			</if>
			<if test="des != null">
				#{des},
			</if>
			<if test="cTime != null">
				#{cTime},
			</if>
			<if test="param1 != null">
				#{param1},
			</if>
			<if test="param2 != null">
				#{param2},
			</if>
			<if test="param3 != null">
				#{param3},
			</if>
			<if test="param4 != null">
				#{param4},
			</if>
			<if test="paramIp != null">
				#{paramIp},
			</if>
		</trim>
	</insert>

	<update id="updateMemberActionLogs" parameterType="com.qiqilm.server.admin.domain.MemberActionLogs">
		update log_member_action
		<trim prefix="SET" suffixOverrides=",">
			<if test="userId != null">
				user_id = #{userId},
			</if>
			<if test="userName != null">
				user_name = #{userName},
			</if>
			<if test="type != null">
				type = #{type},
			</if>
			<if test="des != null">
				des = #{des},
			</if>
			<if test="cTime != null">
				c_time = #{cTime},
			</if>
			<if test="param1 != null">
				param1 = #{param1},
			</if>
			<if test="param2 != null">
				param2 = #{param2},
			</if>
			<if test="param3 != null">
				param3 = #{param3},
			</if>
			<if test="param4 != null">
				param4 = #{param4},
			</if>
			<if test="paramIp != null">
				param_ip = #{paramIp},
			</if>
		</trim>
		where id = #{id}
	</update>

	<delete id="deleteMemberActionLogsById" parameterType="String">
		delete
		from log_member_action
		where id = #{id}
	</delete>

	<delete id="deleteMemberActionLogsByIds" parameterType="String">
		delete
		from log_member_action where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>
</mapper>