<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveVideoPropMapper">

    <resultMap type="LiveVideoProp" id="LiveVideoPropResult">
        <result property="id"    column="id"    />
        <result property="propId"    column="prop_id"    />
        <result property="propName"    column="prop_name"    />
        <result property="totalScore"    column="total_score"    />
        <result property="totalDiamonds"    column="total_diamonds"    />
        <result property="totalTicket"    column="total_ticket"    />
        <result property="currentDiamonds"    column="current_diamonds"    />
        <result property="beforeTicket"    column="before_ticket"    />
        <result property="fromUserId"    column="from_user_id"    />
        <result property="pUserId"    column="p_user_id"    />
        <result property="pUserName"    column="p_user_name"    />
        <result property="toUserId"    column="to_user_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="createDate"    column="create_date"    />
        <result property="createY"    column="create_y"    />
        <result property="createM"    column="create_m"    />
        <result property="createD"    column="create_d"    />
        <result property="createW"    column="create_w"    />
        <result property="num"    column="num"    />
        <result property="videoId"    column="video_id"    />
        <result property="groupId"    column="group_id"    />
        <result property="isRedEnvelope"    column="is_red_envelope"    />
