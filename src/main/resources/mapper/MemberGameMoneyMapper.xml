<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qiqilm.server.admin.mapper.MemberGameMoneyMapper">
	<resultMap type="MemberGameMoney" id="MemberGameMoneyResult">
		<result property="id" column="id"/>
		<result property="memberId" column="member_id"/>
		<result property="platformId" column="platform_id"/>
		<result property="status" column="status"/>
		<result property="money" column="money"/>
		<result property="ctime" column="c_time"/>
		<result property="oderSn" column="oder_sn"/>
	</resultMap>

	<sql id="selectMemberGameMoneyVo">
		select id, member_id, platform_id, status, money, c_time, oder_sn
		from ${dbMain}.member_game_money
	</sql>

	<select id="selectMemberGameMoneyList" parameterType="MemberGameMoney" resultMap="MemberGameMoneyResult">
		<include refid="selectMemberGameMoneyVo"/>
		<where>
			<if test="memberId != null  and memberId != ''">
				and member_id = #{memberId}
			</if>
			<if test="platformId != null">
				and platform_id = #{platformId}
			</if>
			<if test="status != null">
				and status = #{status}
			</if>
			<if test="money != null">
				and money = #{money}
			</if>
			<if test="ctime != null">
				and c_time = #{ctime}
			</if>
			<if test="oderSn != null  and oderSn != ''">
				and oder_sn = #{oderSn}
			</if>
		</where>
		ORDER BY c_time desc
	</select>

	<select id="selectMemberGameMoneyById" parameterType="String" resultMap="MemberGameMoneyResult">
		<include refid="selectMemberGameMoneyVo"/>
		where id = #{id}
	</select>

	<insert id="insertMemberGameMoney" parameterType="MemberGameMoney">
		insert into ${dbMain}.member_game_money
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">
				id,
			</if>
			<if test="memberId != null">
				member_id,
			</if>
			<if test="platformId != null">
				platform_id,
			</if>
			<if test="status != null">
				status,
			</if>
			<if test="money != null">
				money,
			</if>
			<if test="ctime != null">
				c_time,
			</if>
			<if test="oderSn != null">
				oder_sn,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">
				#{id},
			</if>
			<if test="memberId != null">
				#{memberId},
			</if>
			<if test="platformId != null">
				#{platformId},
			</if>
			<if test="status != null">
				#{status},
			</if>
			<if test="money != null">
				#{money},
			</if>
			<if test="ctime != null">
				#{ctime},
			</if>
			<if test="oderSn != null">
				#{oderSn},
			</if>
		</trim>
	</insert>

	<update id="updateMemberGameMoney" parameterType="MemberGameMoney">
		update ${dbMain}.member_game_money
		<trim prefix="SET" suffixOverrides=",">
			<if test="memberId != null">
				member_id = #{memberId},
			</if>

			<if test="platformId != null">
				platform_id = #{platformId},
			</if>

			<if test="status != null">
				status = #{status},
			</if>

			<if test="money != null">
				money = #{money},
			</if>

			<if test="ctime != null">
				c_time = #{ctime},
			</if>

			<if test="oderSn != null">
				oder_sn = #{oderSn},
			</if>
		</trim>
		where id = #{id}
	</update>
</mapper>