	<select id="findList" resultType="com.qiqilm.server.admin.domain.rsp.RspPayJour">
		select j.*, p.name platform_name, c.name channel_name, c.pay_rate from (
		<include refid="selectMemberPayJourVo"/>
		<where>
			<include refid="listWhere"/>
		</where>
		) j
				left join pay_platform_new p on j.platform_id = p.id
				left join pay_channel_new c on j.channel_id = c.id
				order by j.update_time desc
	</select>

	<sql id="listWhere">
		<if test="req.status != null and req.status lt 2">
			and status = #{req.status}
		</if>
		<if test="req.status != null and req.status == 2">
			and status = '1' and is_patch_order = 1
		</if>
		<if test="req.platformId != null and req.platformId != ''">
			and platform_id = #{req.platformId}
		</if>
		<if test="req.searchOrderNo != null and req.searchOrderNo != ''">
			and (trade_sn = #{req.searchOrderNo} or order_no = #{req.searchOrderNo})
		</if>
		<if test="req.searchValue != null and req.searchValue != ''">
			and (member_id = #{req.searchValue} or user_name = #{req.searchValue})
		</if>
		<if test="req.selectStartDate != null and req.selectStartDate != ''">
			and update_time <![CDATA[ >= ]]> #{req.selectStartDate} and update_time <![CDATA[ <= ]]> #{req.selectEndDate}
		</if>
	</sql>

	<sql id="transactionsTotal">
		select count(*) total,sum(sub_money) totalMoney
		from member_pay_jour
		where 1=1
		<include refid="listWhere"/>
	</sql>

	<sql id="replenishmentTotal">
		select sum(sub_money) replenishmentTotalMoney
		from member_pay_jour
		where 1=1
		<include refid="listWhere"/>
		and is_patch_order = 1
	</sql>

	<sql id="failureRate">
		select count(*) failCount
		from member_pay_jour
		where 1=1
		<include refid="listWhere"/>
		and status = 0
	</sql>

	<select id="listCount" resultType="java.util.Map">
		select *, 1 - c.failCount / a.total failRate from (<include refid="transactionsTotal"/>)a
			left join (<include refid="replenishmentTotal"/>)b on 1 = 1
			left join (<include refid="failureRate"/>)c on 1 = 1
	</select>

	<select id="selectById" resultType="com.qiqilm.server.admin.domain.rsp.RspPayJour">
		select j.*, p.name platform_name, c.name channel_name, c.pay_rate from (
		<include refid="selectMemberPayJourVo"/>
		) j
				left join pay_platform_new p on j.platform_id = p.id
				left join pay_channel_new c on j.channel_id = c.id
				where j.id = #{id}
	</select>

	<select id="findByOrderNo" resultMap="MemberPayJourResult">
		<include refid="selectMemberPayJourVo"/>
		where order_no = #{orderNo}
	</select>
</mapper>
