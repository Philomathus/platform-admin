		</trim>
	</insert>

	<update id="updateMemberPayJour" parameterType="MemberPayJour">
		update member_pay_jour
		<trim prefix="SET" suffixOverrides=",">
			<if test="memberId != null">
				member_id = #{memberId},
			</if>
			<if test="platformId != null">
				platform_id = #{platformId},
			</if>
			<if test="channelId != null">
