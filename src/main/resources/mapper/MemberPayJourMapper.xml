		<result property="isPatchOrder" column="is_patch_order"/>
		<result property="remark" column="remark"/>
		<result property="platformRate" column="platform_rate"/>
		<result property="currentSuccessRate" column="current_success_rate"/>
		<result property="manWork" column="man_work"/>
		<result property="userName" column="user_name"/>
		<result property="createTimes" column="create_time"/>
		<result property="updateTimes" column="update_time"/>
		<result property="first" column="first"/>
	</resultMap>

	<sql id="selectMemberPayJourVo">
		select id,
			   member_id,
			   platform_id,
			   channel_id,
			   payment_method,
			   order_no,
			   trade_sn,
			   money,
			   sub_money,
			   payment_code,
			   payment_time,
			   pay_time,
			   status,
			   is_patch_order,
			   remark,
			   platform_rate,
			   current_success_rate,
			   man_work,
			   user_name,
			   create_time,
			   update_time,
			   first
		from member_pay_jour
	</sql>

	<select id="selectMemberPayJourList" parameterType="MemberPayJour" resultMap="MemberPayJourResult">
		<include refid="selectMemberPayJourVo"/>
		<where>
			<if test="memberId != null  and memberId != ''">
				and member_id = #{memberId}
			</if>
			<if test="platformId != null  and platformId != ''">
				and platform_id = #{platformId}
			</if>
			<if test="channelId != null  and channelId != ''">
				and channel_id = #{channelId}
			</if>
			<if test="paymentMethod != null  and paymentMethod != ''">
				and payment_method = #{paymentMethod}
			</if>
			<if test="orderNo != null  and orderNo != ''">
				and order_no = #{orderNo}
			</if>
			<if test="tradeSn != null  and tradeSn != ''">
				and trade_sn = #{tradeSn}
			</if>
			<if test="money != null">
				and money = #{money}
			</if>
			<if test="subMoney != null">
				and sub_money = #{subMoney}
			</if>
			<if test="paymentCode != null  and paymentCode != ''">
				and payment_code = #{paymentCode}
			</if>
			<if test="paymentTime != null  and paymentTime != ''">
				and payment_time = #{paymentTime}
			</if>
			<if test="payTime != null  and payTime != ''">
				and pay_time = #{payTime}
			</if>
			<if test="status != null  and status != ''">
				and status = #{status}
			</if>
			<if test="isPatchOrder != null">
				and is_patch_order = #{isPatchOrder}
			</if>
			<if test="platformRate != null">
				and platform_rate = #{platformRate}
			</if>
			<if test="currentSuccessRate != null">
				and current_success_rate = #{currentSuccessRate}
			</if>
			<if test="manWork != null  and manWork != ''">
				and man_work = #{manWork}
			</if>
			<if test="userName != null  and userName != ''">
				and user_name like concat('%', #{userName}, '%')
			</if>
			<if test="first != null">
				and first = #{first}
			</if>
		</where>
	</select>

	<select id="selectMemberPayJourById" parameterType="String" resultMap="MemberPayJourResult">
		<include refid="selectMemberPayJourVo"/>
		where id = #{id}
	</select>

