<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.PayAgentRechargeBankMapper">

    <resultMap type="PayAgentRechargeBank" id="PayAgentRechargeBankResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="bankAccount"    column="bank_account"    />
        <result property="bankName"    column="bank_name"    />
        <result property="icon"    column="icon"    />
        <result property="accountName"    column="account_name"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="creator"    column="creator"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updator"    column="updator"    />
    </resultMap>

    <sql id="selectPayAgentRechargeBankVo">
        select id, name, bank_account, bank_name, icon, account_name, status, remark, create_time, creator, update_time, updator from pay_agent_recharge_bank
    </sql>

    <select id="selectPayAgentRechargeBankList" parameterType="PayAgentRechargeBank" resultMap="PayAgentRechargeBankResult">
        <include refid="selectPayAgentRechargeBankVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="bankAccount != null  and bankAccount != ''"> and bank_account = #{bankAccount}</if>
            <if test="bankName != null  and bankName != ''"> and bank_name like concat('%', #{bankName}, '%')</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="accountName != null  and accountName != ''"> and account_name like concat('%', #{accountName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="updator != null  and updator != ''"> and updator = #{updator}</if>
        </where>
    </select>

    <select id="selectPayAgentRechargeBankById" parameterType="Long" resultMap="PayAgentRechargeBankResult">
        <include refid="selectPayAgentRechargeBankVo"/>
        where id = #{id}
    </select>

    <insert id="insertPayAgentRechargeBank" parameterType="PayAgentRechargeBank" useGeneratedKeys="true" keyProperty="id">
        insert into pay_agent_recharge_bank
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account,</if>
            <if test="bankName != null and bankName != ''">bank_name,</if>
            <if test="icon != null">icon,</if>
            <if test="accountName != null and accountName != ''">account_name,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="creator != null and creator != ''">creator,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updator != null">updator,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="bankAccount != null and bankAccount != ''">#{bankAccount},</if>
            <if test="bankName != null and bankName != ''">#{bankName},</if>
            <if test="icon != null">#{icon},</if>
            <if test="accountName != null and accountName != ''">#{accountName},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="creator != null and creator != ''">#{creator},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updator != null">#{updator},</if>
         </trim>
    </insert>

    <update id="updatePayAgentRechargeBank" parameterType="PayAgentRechargeBank">
        update pay_agent_recharge_bank
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account = #{bankAccount},</if>
            <if test="bankName != null and bankName != ''">bank_name = #{bankName},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="accountName != null and accountName != ''">account_name = #{accountName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="creator != null and creator != ''">creator = #{creator},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updator != null">updator = #{updator},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePayAgentRechargeBankById" parameterType="Long">
        delete from pay_agent_recharge_bank where id = #{id}
    </delete>

    <delete id="deletePayAgentRechargeBankByIds" parameterType="String">
        delete from pay_agent_recharge_bank where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
