<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.ConfigGametypeMapper">

    <resultMap type="ConfigGametype" id="ConfigGametypeResult">
        <result property="id"    column="id"    />
        <result property="platformId"    column="platform_id"    />
        <result property="platformName"    column="platform_name"    />
        <result property="sonPlatformId"    column="son_platform_id"    />
        <result property="sonPlatformName"    column="son_platform_name"    />
    </resultMap>

    <sql id="selectConfigGametypeVo">
        select id, platform_id, platform_name, son_platform_id, son_platform_name from config_gametype
    </sql>

    <select id="selectConfigGametypeList" parameterType="ConfigGametype" resultMap="ConfigGametypeResult">
        <include refid="selectConfigGametypeVo"/>
        <where>
            <if test="platformId != null  and platformId != ''"> and platform_id = #{platformId}</if>
            <if test="platformName != null  and platformName != ''"> and platform_name like concat('%', #{platformName}, '%')</if>
            <if test="sonPlatformId != null  and sonPlatformId != ''"> and son_platform_id = #{sonPlatformId}</if>
            <if test="sonPlatformName != null  and sonPlatformName != ''"> and son_platform_name like concat('%', #{sonPlatformName}, '%')</if>
        </where>
    </select>

    <select id="selectConfigGametypeById" parameterType="String" resultMap="ConfigGametypeResult">
        <include refid="selectConfigGametypeVo"/>
        where id = #{id}
    </select>

    <insert id="insertConfigGametype" parameterType="ConfigGametype">
        insert into config_gametype
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="platformId != null">platform_id,</if>
            <if test="platformName != null">platform_name,</if>
            <if test="sonPlatformId != null">son_platform_id,</if>
            <if test="sonPlatformName != null">son_platform_name,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="platformId != null">#{platformId},</if>
            <if test="platformName != null">#{platformName},</if>
            <if test="sonPlatformId != null">#{sonPlatformId},</if>
            <if test="sonPlatformName != null">#{sonPlatformName},</if>
        </trim>
    </insert>

    <update id="updateConfigGametype" parameterType="ConfigGametype">
        update config_gametype
        <trim prefix="SET" suffixOverrides=",">
            <if test="platformId != null">platform_id = #{platformId},</if>
            <if test="platformName != null">platform_name = #{platformName},</if>
            <if test="sonPlatformId != null">son_platform_id = #{sonPlatformId},</if>
            <if test="sonPlatformName != null">son_platform_name = #{sonPlatformName},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigGametypeById" parameterType="String">
        delete from config_gametype where id = #{id}
    </delete>

    <delete id="deleteConfigGametypeByIds" parameterType="String">
        delete from config_gametype where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="insertExcelSheet" parameterType="String">
        insert into config_gametype(id, platform_id, platform_name, son_platform_id, son_platform_name)
        values (${userIds})
    </insert>

    <select id="findAgentName" resultType="com.qiqilm.server.admin.domain.GamePlatform">
        select agent,name
        from game_platform
        where name = #{cell3}
    </select>

</mapper>