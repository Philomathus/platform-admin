            <if test="ticketToRate != null">ticket_to_rate,</if>
            <if test="payType != null">pay_type,</if>
            <if test="isHistory != null">is_history,</if>
            <if test="isNote != null">is_note,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="totalTime != null">#{totalTime},</if>
                    <if test="totalTicket != null">#{totalTicket},</if>
                    <if test="totalDiamonds != null">#{totalDiamonds},</if>
                    <if test="fromUserId != null">#{fromUserId},</if>
                    <if test="pUserId != null">#{pUserId},</if>
                    <if test="fromUserName != null">#{fromUserName},</if>
                    <if test="toUserId != null">#{toUserId},</if>
