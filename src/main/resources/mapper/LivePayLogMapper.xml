            <if test="newRoomId != null">new_room_id = #{newRoomId},</if>
    
            <if test="totalScore != null">total_score = #{totalScore},</if>
    
            <if test="uesddiamondsToScore != null">uesddiamonds_to_score = #{uesddiamondsToScore},</if>
    
