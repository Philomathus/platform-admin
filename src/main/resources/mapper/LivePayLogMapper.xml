                    <if test="ticketToRate != null">#{ticketToRate},</if>
                    <if test="payType != null">#{payType},</if>
                    <if test="isHistory != null">#{isHistory},</if>
                    <if test="isNote != null">#{isNote},</if>
             </trim>
    </insert>

    <update id="updateLivePayLog" parameterType="LivePayLog">
        update cx_live.live_pay_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="totalTime != null">total_time = #{totalTime},</if>
    
            <if test="totalTicket != null">total_ticket = #{totalTicket},</if>
    
            <if test="totalDiamonds != null">total_diamonds = #{totalDiamonds},</if>
    
            <if test="fromUserId != null">from_user_id = #{fromUserId},</if>
    
