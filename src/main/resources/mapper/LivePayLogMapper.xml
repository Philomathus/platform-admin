                    <if test="createDate != null">#{createDate},</if>
                    <if test="createYm != null">#{createYm},</if>
                    <if test="createD != null">#{createD},</if>
                    <if test="createW != null">#{createW},</if>
                    <if test="liveFee != null">#{liveFee},</if>
                    <if test="livePayTime != null">#{livePayTime},</if>
                    <if test="livePayDate != null">#{livePayDate},</if>
                    <if test="videoId != null">#{videoId},</if>
                    <if test="groupId != null and groupId != ''">#{groupId},</if>
                    <if test="payTimeEnd != null">#{payTimeEnd},</if>
                    <if test="payTimeNext != null">#{payTimeNext},</if>
                    <if test="liveIsMentionTime != null">#{liveIsMentionTime},</if>
                    <if test="liveIsMentionPay != null">#{liveIsMentionPay},</if>
                    <if test="livePayType != null">#{livePayType},</if>
                    <if test="newRoomId != null">#{newRoomId},</if>
                    <if test="totalScore != null">#{totalScore},</if>
