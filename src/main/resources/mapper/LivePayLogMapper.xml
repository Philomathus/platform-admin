    <delete id="deleteLivePayLogById" parameterType="Long">
        delete from cx_live.live_pay_log where id = #{id}
    </delete>

    <delete id="deleteLivePayLogByIds" parameterType="String">
        delete from cx_live.live_pay_log where id in
