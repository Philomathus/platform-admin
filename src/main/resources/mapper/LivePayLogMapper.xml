    <sql id="selectLivePayLogVo">
        select id, total_time, total_ticket, total_diamonds, from_user_id, p_user_id, from_user_name, to_user_id,  FROM_UNIXTIME(create_time) create_time ,  create_date, create_ym, create_d, create_w, live_fee, live_pay_time, live_pay_date, video_id, group_id, pay_time_end, pay_time_next, live_is_mention_time, live_is_mention_pay, live_pay_type, new_room_id, total_score, uesddiamonds_to_score, ticket_to_rate, pay_type, is_history, is_note from cx_live.live_pay_log
    </sql>

    <select id="selectLivePayLogList" parameterType="LivePayLog" resultMap="LivePayLogResult">
        <include refid="selectLivePayLogVo"/>
        <where>
            <if test="totalTime != null "> and total_time = #{totalTime}</if>
            <if test="totalTicket != null "> and total_ticket = #{totalTicket}</if>
            <if test="totalDiamonds != null "> and total_diamonds = #{totalDiamonds}</if>
            <if test="fromUserId != null "> and from_user_id = #{fromUserId}</if>
            <if test="pUserId != null  and pUserId != ''"> and p_user_id = #{pUserId}</if>
            <if test="fromUserName != null  and fromUserName != ''"> and from_user_name like concat('%', #{fromUserName}, '%')</if>
            <if test="toUserId != null "> and to_user_id = #{toUserId}</if>
            <if test="createDate != null "> and create_date = #{createDate}</if>
            <if test="createYm != null  and createYm != ''"> and create_ym = #{createYm}</if>
            <if test="createD != null "> and create_d = #{createD}</if>
            <if test="createW != null "> and create_w = #{createW}</if>
            <if test="liveFee != null "> and live_fee = #{liveFee}</if>
            <if test="livePayTime != null "> and live_pay_time = #{livePayTime}</if>
            <if test="livePayDate != null "> and live_pay_date = #{livePayDate}</if>
            <if test="videoId != null "> and video_id = #{videoId}</if>
            <if test="groupId != null  and groupId != ''"> and group_id = #{groupId}</if>
            <if test="payTimeEnd != null "> and pay_time_end = #{payTimeEnd}</if>
            <if test="payTimeNext != null "> and pay_time_next = #{payTimeNext}</if>
            <if test="liveIsMentionTime != null "> and live_is_mention_time = #{liveIsMentionTime}</if>
            <if test="liveIsMentionPay != null "> and live_is_mention_pay = #{liveIsMentionPay}</if>
            <if test="livePayType != null "> and live_pay_type = #{livePayType}</if>
            <if test="newRoomId != null "> and new_room_id = #{newRoomId}</if>
            <if test="totalScore != null "> and total_score = #{totalScore}</if>
            <if test="uesddiamondsToScore != null "> and uesddiamonds_to_score = #{uesddiamondsToScore}</if>
            <if test="ticketToRate != null "> and ticket_to_rate = #{ticketToRate}</if>
            <if test="payType != null "> and pay_type = #{payType}</if>
            <if test="isHistory != null "> and is_history = #{isHistory}</if>
            <if test="isNote != null "> and is_note = #{isNote}</if>
        </where>
    </select>

    <select id="selectLivePayLogById" parameterType="Long" resultMap="LivePayLogResult">
        <include refid="selectLivePayLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertLivePayLog" parameterType="LivePayLog" useGeneratedKeys="true" keyProperty="id">
        insert into cx_live.live_pay_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="totalTime != null">total_time,</if>
            <if test="totalTicket != null">total_ticket,</if>
            <if test="totalDiamonds != null">total_diamonds,</if>
            <if test="fromUserId != null">from_user_id,</if>
            <if test="pUserId != null">p_user_id,</if>
            <if test="fromUserName != null">from_user_name,</if>
            <if test="toUserId != null">to_user_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createDate != null">create_date,</if>
            <if test="createYm != null">create_ym,</if>
            <if test="createD != null">create_d,</if>
            <if test="createW != null">create_w,</if>
            <if test="liveFee != null">live_fee,</if>
            <if test="livePayTime != null">live_pay_time,</if>
            <if test="livePayDate != null">live_pay_date,</if>
            <if test="videoId != null">video_id,</if>
            <if test="groupId != null and groupId != ''">group_id,</if>
            <if test="payTimeEnd != null">pay_time_end,</if>
