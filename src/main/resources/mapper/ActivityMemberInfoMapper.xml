    <sql id="selectActivityMemberInfoVo">
        select id, member_code, cx_agent, user_name, real_name, status, vip, total_account, phone, email, password, is_online, sex, reg_time, regist_ip, login_ip, login_address, login_dev, nick_name, birth_day, qq, wechat, head_img, online_time, link_url, login_time, box_account, box_pass, clean_time, level_integral, inviter_code, invite_money, code_account, PID, code_total, channelCode, speak, login_num, version, withdrawal_pass, device_id from 7700_main.member_info
    </sql>

    <select id="selectActivityMemberInfoList" parameterType="ActivityMemberInfo" resultMap="ActivityMemberInfoResult">
        select id,reg_time,login_ip,inviter_code,vip,login_time,CASE
        WHEN ${isTwoPw} THEN
        phone
        ELSE
        CONCAT(left(phone,5),'**',RIGHT(phone,4))
        end phone from member_info
        <where>
            and (inviter_code is not null and inviter_code != '')
            and (phone is not null and phone !='')
            <if test="inviterCode != null  and inviterCode != ''"> and inviter_code = #{inviterCode}</if>
            <if test="loginIp != null  and loginIp != ''"> and login_ip = #{loginIp}</if>
            <if test="selectDate != null"> and reg_time >= '${selectDate[0]}'</if>
            <if test="selectDate != null"> and reg_time &lt;= '${selectDate[1]}'</if>
        </where>
    </select>

    <select id="selectActivityMemberInfoById" parameterType="String" resultMap="ActivityMemberInfoResult">
        <include refid="selectActivityMemberInfoVo"/>
        where id = #{id}
    </select>

