<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveHostWageNoteMapper">

    <resultMap type="LiveHostWageNote" id="LiveHostWageNoteResult">
        <result property="id"    column="id"    />
        <result property="familyId"    column="family_id"    />
        <result property="hostId"    column="host_id"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="liveTimeSec"    column="live_time_sec"    />
        <result property="ticket"    column="ticket"    />
        <result property="beforeTotalTicket"    column="before_total_ticket"    />
        <result property="createTime"    column="create_time"    />
        <result property="remark"    column="remark"    />
        <result property="cpCost"    column="cp_cost"    />
        <result property="cpPrize"    column="cp_prize"    />
    </resultMap>

    <sql id="selectLiveHostWageNoteVo">
        select id, family_id, host_id, start_time, end_time, live_time_sec, ticket, before_total_ticket,  FROM_UNIXTIME(create_time) create_time ,  remark, cp_cost, cp_prize from 7700_live.live_host_wage_note
    </sql>

    <select id="selectLiveHostWageNoteList" parameterType="LiveHostWageNote" resultMap="LiveHostWageNoteResult">
        <include refid="selectLiveHostWageNoteVo"/>
        <where>
            <if test="familyId != null "> and family_id = #{familyId}</if>
            <if test="hostId != null "> and host_id = #{hostId}</if>
            <if test="startTime != null  and startTime != ''"> and start_time = #{startTime}</if>
            <if test="endTime != null  and endTime != ''"> and end_time = #{endTime}</if>
            <if test="liveTimeSec != null "> and live_time_sec = #{liveTimeSec}</if>
            <if test="ticket != null "> and ticket = #{ticket}</if>
            <if test="beforeTotalTicket != null "> and before_total_ticket = #{beforeTotalTicket}</if>
            <if test="cpCost != null "> and cp_cost = #{cpCost}</if>
            <if test="cpPrize != null "> and cp_prize = #{cpPrize}</if>
        </where>
    </select>

    <select id="selectLiveHostWageNoteById" parameterType="Long" resultMap="LiveHostWageNoteResult">
        <include refid="selectLiveHostWageNoteVo"/>
        where id = #{id}
    </select>

    <insert id="insertLiveHostWageNote" parameterType="LiveHostWageNote" useGeneratedKeys="true" keyProperty="id">
        insert into 7700_live.live_host_wage_note
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="familyId != null">family_id,</if>
            <if test="hostId != null">host_id,</if>
            <if test="startTime != null and startTime != ''">start_time,</if>
            <if test="endTime != null and endTime != ''">end_time,</if>
            <if test="liveTimeSec != null">live_time_sec,</if>
            <if test="ticket != null">ticket,</if>
            <if test="beforeTotalTicket != null">before_total_ticket,</if>
            <if test="createTimes != null and createTime != ''">create_time,</if>
            <if test="remark != null">remark,</if>
            <if test="cpCost != null">cp_cost,</if>
            <if test="cpPrize != null">cp_prize,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="familyId != null">#{familyId},</if>
                    <if test="hostId != null">#{hostId},</if>
                    <if test="startTime != null and startTime != ''">#{startTime},</if>
                    <if test="endTime != null and endTime != ''">#{endTime},</if>
                    <if test="liveTimeSec != null">#{liveTimeSec},</if>
                    <if test="ticket != null">#{ticket},</if>
                    <if test="beforeTotalTicket != null">#{beforeTotalTicket},</if>
                <if test="createTimes != null and createTimes != ''">#{createTimes},</if>
                    <if test="remark != null">#{remark},</if>
                    <if test="cpCost != null">#{cpCost},</if>
                    <if test="cpPrize != null">#{cpPrize},</if>
             </trim>
    </insert>

    <update id="updateLiveHostWageNote" parameterType="LiveHostWageNote">
        update 7700_live.live_host_wage_note
        <trim prefix="SET" suffixOverrides=",">
            <if test="familyId != null">family_id = #{familyId},</if>
    
            <if test="hostId != null">host_id = #{hostId},</if>
    
            <if test="startTime != null and startTime != ''">start_time = #{startTime},</if>
    
            <if test="endTime != null and endTime != ''">end_time = #{endTime},</if>
    
            <if test="liveTimeSec != null">live_time_sec = #{liveTimeSec},</if>
    
            <if test="ticket != null">ticket = #{ticket},</if>
    
            <if test="beforeTotalTicket != null">before_total_ticket = #{beforeTotalTicket},</if>
    
            <if test="createTimes != null and createTimes != ''">create_time = #{createTimes},</if>
    
            <if test="remark != null">remark = #{remark},</if>
    
            <if test="cpCost != null">cp_cost = #{cpCost},</if>
    
            <if test="cpPrize != null">cp_prize = #{cpPrize},</if>
    
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLiveHostWageNoteById" parameterType="Long">
        delete from 7700_live.live_host_wage_note where id = #{id}
    </delete>

    <delete id="deleteLiveHostWageNoteByIds" parameterType="String">
        delete from 7700_live.live_host_wage_note where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="beforeNote" resultMap="LiveHostWageNoteResult">
        select * from 7700_live.live_host_wage_note  l where l.host_id=#{userId}  ORDER BY create_time desc LIMIT 1
    </select>
</mapper>
