<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveMountMapper">

    <resultMap type="LiveMount" id="LiveMountResult">
        <result property="id"    column="id"    />
        <result property="gvip"    column="gvip"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="iconUrl"    column="icon_url"    />
        <result property="svgUrl"    column="svg_url"    />
        <result property="price"    column="price"    />
        <result property="disPrice"    column="dis_price"    />
        <result property="vday"    column="vday"    />
    </resultMap>

    <sql id="selectLiveMountVo">
        select id, gvip, name, status, icon_url, svg_url, price, dis_price, vday,oder from ${dbLive}.live_mount
    </sql>

    <select id="selectLiveMountList" parameterType="LiveMount" resultMap="LiveMountResult">
        <include refid="selectLiveMountVo"/>
        <where>
            <if test="gvip != null "> and gvip = #{gvip}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="iconUrl != null  and iconUrl != ''"> and icon_url = #{iconUrl}</if>
            <if test="svgUrl != null  and svgUrl != ''"> and svg_url = #{svgUrl}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="disPrice != null "> and dis_price = #{disPrice}</if>
            <if test="vday != null "> and vday = #{vday}</if>
            <if test="oder != null  and oder != ''"> and oder = #{oder}</if>
        </where>
        order by oder ASC
    </select>

    <select id="selectLiveMountById" parameterType="Long" resultMap="LiveMountResult">
        <include refid="selectLiveMountVo"/>
        where id = #{id}
    </select>

    <insert id="insertLiveMount" parameterType="LiveMount" useGeneratedKeys="true" keyProperty="id">
        insert into ${dbLive}.live_mount
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="gvip != null">gvip,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="status != null">status,</if>
            <if test="iconUrl != null and iconUrl != ''">icon_url,</if>
            <if test="svgUrl != null">svg_url,</if>
            <if test="price != null">price,</if>
            <if test="disPrice != null">dis_price,</if>
            <if test="vday != null">vday,</if>
            <if test="oder != null and name != ''">oder,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gvip != null">#{gvip},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="iconUrl != null and iconUrl != ''">#{iconUrl},</if>
            <if test="svgUrl != null">#{svgUrl},</if>
            <if test="price != null">#{price},</if>
            <if test="disPrice != null">#{disPrice},</if>
            <if test="vday != null">#{vday},</if>
            <if test="oder != null and oder != ''">#{oder},</if>
         </trim>
    </insert>

    <update id="updateLiveMount" parameterType="LiveMount">
        update ${dbLive}.live_mount
        <trim prefix="SET" suffixOverrides=",">
            <if test="gvip != null">gvip = #{gvip},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="iconUrl != null and iconUrl != ''">icon_url = #{iconUrl},</if>
            <if test="svgUrl != null">svg_url = #{svgUrl},</if>
            <if test="price != null">price = #{price},</if>
            <if test="disPrice != null">dis_price = #{disPrice},</if>
            <if test="vday != null">vday = #{vday},</if>
            <if test="oder != null and oder != ''">oder = #{oder},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLiveMountById" parameterType="Long">
        delete from ${dbLive}.live_mount where id = #{id}
    </delete>

    <delete id="deleteLiveMountByIds" parameterType="String">
        delete from ${dbLive}.live_mount where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
