    <select id="selectMemberInfoWithdrawByIdb" parameterType="String"
            resultType="com.qiqilm.server.admin.domain.rsp.RspMemberInfo">
        SELECT IFNULL(SUM(recharge_money), 0) rechargemoney
        from member_recharge_log
        where type = '1'
          and status = '3'
          and member_id = #{userid}
    </select>

    <select id="selectMemberInfoWithdrawByIdc" parameterType="String"
