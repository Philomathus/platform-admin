    <select id="selectMemberInfoList" parameterType="MemberInfo" resultMap="MemberInfoResult">
        <include refid="selectMemberInfoVo"/>
        <where>
            <if test="bankAccount != null  and bankAccount != ''">
                and id in (select member_id
                           from member_card
                           where bank_account = #{bankAccount} or real_name = #{bankAccount})
            </if>
            <!--<if test="searchValue != null  and searchValue != ''">
                and (id = #{searchValue} or phone = #{searchValue} or user_name = #{searchValue})
            </if>-->
            <if test="status != null">
                and id in (select id from member_info where status = #{status})
            </if>
            <if test="email != null and email != ''">
                and email like concat('%', #{email}, '%')
            </if>
            <if test="registIp != null  and registIp != ''">
                and regist_ip = #{registIp}
            </if>
            <if test="loginIp != null  and loginIp != ''">
                and login_ip = #{loginIp}
            </if>
            <if test="realName != null  and realName != ''">
                and id in (select member_id from member_card where real_name = #{realName})
            </if>
            <if test="nickName != null  and nickName != ''">
                and id in (select id from member_info where nick_name like concat('%', #{nickName}, '%'))
            </if>
            <if test="inviterCode != null  and inviterCode != ''">
                and inviter_code = #{inviterCode}
            </if>
            <if test="channelcode != null  and channelcode != ''">
                and channelCode = #{channelcode}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                <!-- 开始时间检索 -->
                AND reg_time <![CDATA[ >= ]]> STR_TO_DATE(#{params.beginTime}, '%Y-%m-%d %H:%i:%s')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                <!-- 结束时间检索 -->
                AND reg_time <![CDATA[ <= ]]> STR_TO_DATE(#{params.endTime}, '%Y-%m-%d %H:%i:%s')
            </if>
            <if test="downLoadDate[0] != null">
                and reg_time <![CDATA[ >= ]]> '${downLoadDate[0]}'
            </if>
            <if test="downLoadDate[1] != null">
                and reg_time <![CDATA[ <= ]]> '${downLoadDate[1]}'
            </if>
            <if test="version != null  and version != ''">
                and version = #{version}
            </if>
            <if test="loginDev != null  and loginDev != ''">
                and login_dev = #{loginDev}
            </if>
            <if test="vipMin != null and vipMin != ''">
                and vip <![CDATA[ >= ]]> #{vipMin}
            </if>
            <if test="vipMax != null and vipMax != ''">
                and vip <![CDATA[ <= ]]> #{vipMax}
            </if>

            <if test="searchValues != null and searchValues.size() != 0">
                and (id in
                <foreach item="value" collection="searchValues" open="(" separator="," close=")">
                    #{value}
                </foreach>
                or phone in
                <foreach item="value" collection="searchValues" open="(" separator="," close=")">
                    #{value}
                </foreach>
                 or user_name in
                <foreach item="value" collection="searchValues" open="(" separator="," close=")">
                    #{value}
                </foreach>
                )
            </if>

            <if test="vipMin != null and vipMax != null  and vipMin != ''  and vipMax != ''">
                and vip <![CDATA[ >= ]]> #{vipMin}
                and vip <![CDATA[ <= ]]> #{vipMax}
            </if>
            <if test="levelIntegral != null">
                <choose>
                    <when test="levelIntegral == 0">
                        and level_integral <![CDATA[ <= ]]> 0
                    </when>
                    <otherwise>
                        and level_integral > 0
                    </otherwise>
                </choose>
            </if>

            <if test="integral != null and integral != ''">
                and code_total/level_integral <![CDATA[ > ]]> #{integral}
            </if>


        </where>
        order by reg_time desc
    </select>

