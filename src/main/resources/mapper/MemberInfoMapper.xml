    <select id="selectMaxMemberCode" resultType="java.lang.Integer">
        select IFNULL(max(member_code), 0)
        from member_info
    </select>

    <update id="updateMoneySelect">
        update member_info
        <set>
            <if test="money != null">
                total_account = total_account + #{money},
            </if>
            <if test="invite_money != null">
                invite_money = invite_money + #{invite_money},
            </if>
            <if test="level_integral != null">
                level_integral = level_integral + #{level_integral},
            </if>

            <if test="code_account != null">
                code_account = convert(code_account + #{code_account}, decimal(15, 2)),
            </if>

            <if test="code_total != null">
                code_total = convert(code_total + #{code_total}, decimal(15, 2))
            </if>
        </set>
        where id = #{userId}
        <if test="money != null">
            and total_account + #{money} <![CDATA[ >= ]]> 0
        </if>
    </update>

