    <select id="personalRecharge" resultType="java.math.BigDecimal">
          select ifnull(SUM(recharge_money),0) as n from member_recharge_log
            where status = 3
            and update_time >= #{startTime}
            and update_time  <![CDATA[ <= ]]> #{endTime}
            and member_id = #{memberId};
    </select>

    <select id="personalOnlineRecharge" resultType="java.math.BigDecimal">
        select ifnull(SUM(money),0) as n
        from ${dbMain}.member_pay_jour
         where
             status = 1 and
             update_time >= #{startTime} and
             update_time <![CDATA[ <= ]]> #{endTime} and
             member_id= #{memberId}
    </select>

    <select id="personalAgentRecharge" resultType="java.math.BigDecimal">
        select ifnull(SUM(money),0) as n from pay_agent_recharge_log
        where create_time >= #{startTime} and
        create_time <![CDATA[ <= ]]> #{endTime} and
        member_id= #{memberId}
    </select>
    <select id="personalUsdtRecharge" resultType="java.math.BigDecimal">
        select ifnull(SUM(recharge_money),0) as n from pay_usdt_recharge
        WHERE status = 3 and
        update_time >= #{startTime} and
        update_time <![CDATA[ <= ]]> #{endTime} and
        member_id= #{memberId}
   </select>
    <select id="personalWithdrawRecharge" resultType="java.math.BigDecimal">
        select ifnull(SUM(withdraw_money),0) as n from member_withdraw_log
        where member_id = #{memberId} and
        status in(3,6) and
        update_time >= #{startTime} and
        update_time <![CDATA[ <= ]]> #{endTime};
    </select>

    <select id="personalLiverVideoProp" resultType="java.math.BigDecimal">
        select ifnull(SUM(total_diamonds),0) from ${dbLive}.live_video_prop
        where create_date >= #{startTime}  and
        create_date <![CDATA[ <= ]]> #{endTime} and
        total_diamonds>0 and
         p_user_id = #{memberId}
    </select>

    <select id="personalGameData" resultType="Map">
        select a.*, p.name platformName
        from (select ifnull(SUM(cell_score), 0) as cellScore,
                     ifnull(SUM(all_bet), 0)    as allBet,
                     ifnull(SUM(profit), 0)     as profit,
                     platform_id                   platformId
              from member_game_data${dbNodes}
              where account = #{memberId}
                and game_end_time >= #{startTime}
                and game_end_time <![CDATA[ <= ]]> #{endTime}
                and profit <![CDATA[ <> ]]> 0
              GROUP BY platform_id) a
                 left join game_platform p on p.id = a.platformId
    </select>
    <select id="totalAccount" resultType="hashmap">
        select total_account,box_account from ${dbMain}.member_info
        where id = #{memberId}
    </select>

    <select id="selectLiveGuard" parameterType="LiveGuardUser" resultType="LiveGuardUser">
        select
            anchor_id as anchorId,
            start_time,
            type,
            DATE_FORMAT(guard_end_time,'%Y-%m-%d %H:%i:%s') as guardEndTime
        from
            ${dbLive}.live_guard_user
        where
            p_user_id = #{userId}
          and
            guard_end_time >= now()
    </select>
    <select id="selectUserNameById" resultType="java.lang.String">
        SELECT user_name
        from ${dbMain}.member_info
        where id = #{memberId}
    </select>

    <update id="updateCodeTotalVipLevel" parameterType="MemberInfo">
        update ${dbMain}.member_info
        set vip = (select max(level_flag) from ${dbMain}.config_vip
                   where level_money <![CDATA[ <= ]]> #{codeTotal}),
            code_total = #{codeTotal}
        where id = #{id}
    </update>

