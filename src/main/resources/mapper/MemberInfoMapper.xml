         FROM member_game_data${tableLast}
         WHERE agent in ('10000', '80000')
           and (cell_score - profit) / cell_score > 1
           and 1.04 > (cell_score - profit) / cell_score
           and account = #{userid})
    </select>

    <select id="selectMemberInfoWithdrawByIdk" parameterType="String"
            resultType="com.qiqilm.server.admin.domain.rsp.RspMemberInfo">
        select count(1) gtcount
        FROM member_game_data${tableLast}
        WHERE agent in ('10000', '80000')
          and account = #{userid}
    </select>

    <select id="selectMemberInfoWithdrawByIdl" parameterType="String"
            resultType="com.qiqilm.server.admin.domain.rsp.RspMemberInfo">
        SELECT p.NAME AS class_twoname, a.*
        FROM (SELECT g.platform_id,
                     CONVERT(sum(g.cell_score), DECIMAL(10, 2)) touZhu,
                     CONVERT(sum(g.profit), DECIMAL(10, 2))     yingLi
              FROM member_game_data${tableLast} g
              WHERE account = #{userid}
              GROUP BY g.platform_id) a
                 LEFT JOIN game_platform p ON a.platform_id = p.id
    </select>

    <select id="selectMemberInfoWithdrawByIdz" parameterType="String"
            resultType="com.qiqilm.server.admin.domain.rsp.RspMemberInfo">
        SELECT IFNULL(SUM(recharge_money), 0) usdtrechargemoney
        from pay_usdt_recharge
        where status = '3'
          and member_id = #{userid}
    </select>

    <select id="selectRegisterByMemberIds" parameterType="java.lang.String" resultMap="MemberInfoResult">
        select id, reg_time
        from member_info
        where id in (${memberIds})
    </select>

    <select id="memberstatistics" resultType="com.qiqilm.server.admin.domain.rsp.RspMemberChannel">
        select ifnull((count(*)), 0) number, channelCode as channelcode, email, inviter_code as inviterCode
        from member_info
        <where>
            <if test="inviterCode != null and inviterCode != ''">
                and inviter_code = #{inviterCode}
            </if>
            <if test="channelcode != null  and channelcode != ''">
                and channelCode = #{channelcode}
            </if>
            <if test="email != null and email != ''">
                and email like concat('%', #{email}, '%')
            </if>
            <!--<if test="status != null and status !='' ">
                and id in (select id from member_info where status = #{status})
            </if>-->
            <if test="params.beginTime != null and params.beginTime != ''">
                <!-- 开始时间检索 -->
                AND reg_time <![CDATA[ >= ]]> STR_TO_DATE(#{params.beginTime}, '%Y-%m-%d %H:%i:%s')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                <!-- 结束时间检索 -->
                AND reg_time <![CDATA[ <= ]]> STR_TO_DATE(#{params.endTime}, '%Y-%m-%d %H:%i:%s')
            </if>
            <if test="downLoadDate[0] != null">
                and reg_time <![CDATA[ >= ]]> '${downLoadDate[0]}'
            </if>
            <if test="downLoadDate[1] != null">
                and reg_time <![CDATA[ <= ]]> '${downLoadDate[1]}'
            </if>
        </where>
        GROUP BY email, channelCode
    </select>
    <update id="changeEmail">
        UPDATE member_info
        set email = #{email}
        <where>
            id = #{id}
        </where>
    </update>


    <select id="listCount" resultType="java.util.Map">
        select count(1)           peopledTotal,
               SUM(total_account) totalMoney,
               SUM(box_account)   safeBalanceTotalMoney
        from member_info
        <where>
            <if test="bankAccount != null  and bankAccount != ''">
                and id in (select member_id from member_card where bank_account = #{bankAccount})
            </if>
            <if test="searchValue != null  and searchValue != ''">
                and (id = #{searchValue} or phone = #{searchValue} or user_name = #{searchValue})
            </if>
            <if test="email != null and email != ''">
                and email like concat('%', #{email}, '%')
            </if>
            <if test="registIp != null  and registIp != ''">
                and regist_ip = #{registIp}
            </if>
            <if test="loginIp != null  and loginIp != ''">
                and login_ip = #{loginIp}
            </if>
            <if test="nickName != null  and nickName != ''">
                and id in (select id from member_info where nick_name like concat('%', #{nickName}, '%'))
            </if>
            <if test="inviterCode != null  and inviterCode != ''">
                and inviter_code = #{inviterCode}
            </if>
            <if test="channelcode != null  and channelcode != ''">
                and channelCode = #{channelcode}
            </if>
            <!--			<if test="params.beginTime != null and params.beginTime != ''">&lt;!&ndash; 开始时间检索 &ndash;&gt;-->
            <!--				AND reg_time <![CDATA[ >= ]]> STR_TO_DATE(#{params.beginTime},'%Y-%m-%d %H:%i:%s')-->
            <!--			</if>-->
            <!--			<if test="params.endTime != null and params.endTime != ''">&lt;!&ndash; 结束时间检索 &ndash;&gt;-->
            <!--				AND reg_time <![CDATA[ <= ]]> STR_TO_DATE(#{params.endTime},'%Y-%m-%d %H:%i:%s')-->
            <!--			</if>-->
            <!--			<if test="downLoadDate[0] != null "> and reg_time <![CDATA[ >= ]]> '${downLoadDate[0]}'</if>-->
            <!--			<if test="downLoadDate[1] != null "> and reg_time <![CDATA[ <= ]]> '${downLoadDate[1]}'</if>-->
            and `status` NOT in ("2", "5")
