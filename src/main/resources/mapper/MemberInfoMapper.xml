        SELECT IFNULL(SUM(sub_money), 0) submoney
        from member_pay_jour
        where status = '1'
          and member_id = #{userid}
          and pay_time <![CDATA[ >= ]]> DATE_SUB(NOW(), INTERVAL 30 DAY)
    </select>

