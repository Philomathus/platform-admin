    <delete id="clear">
        delete
        from member_money
        where 1 = 1
    </delete>

    <insert id="insertPaiSong" parameterType="String">
        insert into member_money(member_id, money, beat)
        values (${userIds})
    </insert>

    <select id="selectNikeNameById" resultMap="MemberInfoResult">
        select nick_name, id
        from member_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!--	creating ban on click ban status-->
    <update id="banStatus">
        UPDATE member_info i left join member_card c on i.id = c.member_id
        set i.status=0
        WHERE
            1 = 1
        <if test="array != null and array.size() != 0">
            and i.id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>

        <if test="realName != null">
            and c.real_name = #{realName}
        </if>
    </update>

    <!--	creating ban on click unBlock Status-->
    <update id="unBlockStatus">
        UPDATE member_info i left join member_card c on i.id = c.member_id
        set i.status=1
        WHERE
        1 = 1
        <if test="array != null and array.size() != 0">
            and i.id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>

        <if test="realName != null">
            and c.real_name = #{realName}
        </if>
    </update>

    <update id="boxDish">
        update member_info set total_account = total_account+box_account, box_account = 0 where id = #{memberId}
    </update>
    <update id="withdrawStatus" parameterType="MemberInfo">
        update member_info
        <trim prefix="SET" suffixOverrides=",">
            birth_day = #{birthDay}
        </trim>
        where id = #{id}
    </update>

    <!--	find by ip address -->
