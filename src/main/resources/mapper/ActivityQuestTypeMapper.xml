<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.ActivityQuestTypeMapper">

    <resultMap type="ActivityQuestType" id="ActivityQuestTypeResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="gameId"    column="game_id"    />
        <result property="sort"    column="sort"    />
    </resultMap>

    <sql id="selectActivityQuestTypeVo">
        select id, name,`sort`, create_by, create_time, game_id from activity_quest_type
    </sql>

    <select id="selectActivityQuestTypeList" parameterType="ActivityQuestType" resultMap="ActivityQuestTypeResult">
        <include refid="selectActivityQuestTypeVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="gameId != null  and gameId != ''"> and game_id = #{gameId}</if>
        </where>
        order by sort asc
    </select>

    <select id="selectActivityQuestTypeById" parameterType="String" resultMap="ActivityQuestTypeResult">
        <include refid="selectActivityQuestTypeVo"/>
        where id = #{id}
    </select>

    <select id="selectActivityQuestType" parameterType="ActivityQuestType" resultMap="ActivityQuestTypeResult">
        <include refid="selectActivityQuestTypeVo"/>
    </select>

    <insert id="insertActivityQuestType" parameterType="ActivityQuestType">
        insert into activity_quest_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="gameId != null">game_id,</if>
            <if test="sort != null">sort,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="gameId != null">#{gameId},</if>
            <if test="sort != null">#{sort},</if>
         </trim>
    </insert>

    <update id="updateActivityQuestType" parameterType="ActivityQuestType">
        update activity_quest_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="gameId != null">game_id = #{gameId},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteActivityQuestTypeById" parameterType="String">
        delete from activity_quest_type where id = #{id}
    </delete>

    <delete id="deleteActivityQuestTypeByIds" parameterType="String">
        delete from activity_quest_type where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="nameSelect" parameterType="ActivityQuestInfo" resultMap="ActivityQuestTypeResult">
        select name from activity_quest_type
    </select>
</mapper>
