<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveFamilyJoinMapper">

    <resultMap type="LiveFamilyJoin" id="LiveFamilyJoinResult">
        <result property="id"    column="id"    />
        <result property="familyId"    column="family_id"    />
        <result property="userId"    column="user_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="status"    column="status"    />
        <result property="memo"    column="memo"    />
        <result property="nickName"    column="nick_name"    />
        <result property="headImage"    column="head_image"    />
    </resultMap>

    <sql id="selectLiveFamilyJoinVo">
        select id, family_id, user_id,  FROM_UNIXTIME(create_time) create_time ,  status, memo, nick_name, head_image from 7700_live.live_family_join
    </sql>

    <select id="selectLiveFamilyJoinList" parameterType="LiveFamilyJoin" resultMap="LiveFamilyJoinResult">
        <include refid="selectLiveFamilyJoinVo"/>
        <where>
            <if test="familyId != null "> and family_id = #{familyId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="memo != null  and memo != ''"> and memo = #{memo}</if>
            <if test="nickName != null  and nickName != ''"> and nick_name like concat('%', #{nickName}, '%')</if>
            <if test="headImage != null  and headImage != ''"> and head_image = #{headImage}</if>
        </where>
    </select>

    <select id="selectLiveFamilyJoinById" parameterType="String" resultMap="LiveFamilyJoinResult">
        <include refid="selectLiveFamilyJoinVo"/>
        where id = #{id}
    </select>

    <insert id="insertLiveFamilyJoin" parameterType="LiveFamilyJoin">
        insert into 7700_live.live_family_join
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="familyId != null">family_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="status != null">status,</if>
            <if test="memo != null and memo != ''">memo,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="headImage != null">head_image,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                    <if test="familyId != null">#{familyId},</if>
                    <if test="userId != null">#{userId},</if>
                <if test="createTime != null">UNIX_TIMESTAMP(#{createTime}),</if>
                    <if test="status != null">#{status},</if>
                    <if test="memo != null and memo != ''">#{memo},</if>
                    <if test="nickName != null">#{nickName},</if>
                    <if test="headImage != null">#{headImage},</if>
             </trim>
    </insert>

    <update id="updateLiveFamilyJoin" parameterType="LiveFamilyJoin">
        update 7700_live.live_family_join
        <trim prefix="SET" suffixOverrides=",">
            <if test="familyId != null">family_id = #{familyId},</if>
    
            <if test="userId != null">user_id = #{userId},</if>
    
            <if test="createTime != null">create_time = UNIX_TIMESTAMP(#{createTime}),</if>
    
            <if test="status != null">status = #{status},</if>
    
            <if test="memo != null and memo != ''">memo = #{memo},</if>
    
            <if test="nickName != null">nick_name = #{nickName},</if>
    
            <if test="headImage != null">head_image = #{headImage},</if>
    
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLiveFamilyJoinById" parameterType="String">
        delete from 7700_live.live_family_join where id = #{id}
    </delete>

    <delete id="deleteLiveFamilyJoinByIds" parameterType="String">
        delete from 7700_live.live_family_join where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
