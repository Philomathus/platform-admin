<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveHostWageDayMapper">

    <resultMap type="LiveHostWageDay" id="LiveHostWageDayResult">
        <result property="id"    column="id"    />
        <result property="familyId"    column="family_id"    />
        <result property="hostId"    column="host_id"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="liveTimeSec"    column="live_time_sec"    />
        <result property="ticket"    column="ticket"    />
        <result property="times"    column="times"    />
    </resultMap>

    <sql id="selectLiveHostWageDayVo">
        select id, family_id, host_id, start_time, end_time, live_time_sec, ticket, times from 7700_live.live_host_wage_day
    </sql>

    <select id="selectLiveHostWageDayList" parameterType="LiveHostWageDay" resultMap="LiveHostWageDayResult">
        <include refid="selectLiveHostWageDayVo"/>
        <where>
            <if test="familyId != null "> and family_id = #{familyId}</if>
            <if test="hostId != null "> and host_id = #{hostId}</if>
            <if test="startTime != null  and startTime != ''"> and start_time = #{startTime}</if>
            <if test="endTime != null  and endTime != ''"> and end_time = #{endTime}</if>
            <if test="liveTimeSec != null "> and live_time_sec = #{liveTimeSec}</if>
            <if test="ticket != null "> and ticket = #{ticket}</if>
            <if test="times != null "> and times = #{times}</if>
        </where>
    </select>

    <select id="selectLiveHostWageDayById" parameterType="String" resultMap="LiveHostWageDayResult">
        <include refid="selectLiveHostWageDayVo"/>
        where id = #{id}
    </select>

    <insert id="insertLiveHostWageDay" parameterType="LiveHostWageDay">
        insert into 7700_live.live_host_wage_day
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="familyId != null">family_id,</if>
            <if test="hostId != null">host_id,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="liveTimeSec != null">live_time_sec,</if>
            <if test="ticket != null">ticket,</if>
            <if test="times != null">times,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="familyId != null">#{familyId},</if>
            <if test="hostId != null">#{hostId},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="liveTimeSec != null">#{liveTimeSec},</if>
            <if test="ticket != null">#{ticket},</if>
            <if test="times != null">#{times},</if>
        </trim>
    </insert>

    <update id="updateLiveHostWageDay" parameterType="LiveHostWageDay">
        update 7700_live.live_host_wage_day
        <trim prefix="SET" suffixOverrides=",">
            <if test="familyId != null">family_id = #{familyId},</if>

            <if test="hostId != null">host_id = #{hostId},</if>

            <if test="startTime != null">start_time = #{startTime},</if>

            <if test="endTime != null">end_time = #{endTime},</if>

            <if test="liveTimeSec != null">live_time_sec = #{liveTimeSec},</if>

            <if test="ticket != null">ticket = #{ticket},</if>

            <if test="times != null">times = #{times},</if>

        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLiveHostWageDayById" parameterType="String">
        delete from 7700_live.live_host_wage_day where id = #{id}
    </delete>

    <delete id="deleteLiveHostWageDayByIds" parameterType="String">
        delete from 7700_live.live_host_wage_day where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>