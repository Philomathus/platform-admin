            <if test="gamecell != null">gamecell,</if>
            <if test="gamebet != null">gamebet,</if>
            <if test="gamerevenve != null">gamerevenve,</if>
            <if test="gameprofit != null">gameprofit,</if>
            <if test="plampfit != null">plampfit,</if>
            <if test="bili != null">bili,</if>
            <if test="begindate != null">begindate,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gameUuid != null">#{gameUuid},</if>
