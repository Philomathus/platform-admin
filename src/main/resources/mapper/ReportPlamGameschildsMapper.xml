            <if test="gamerevenve != null">#{gamerevenve},</if>
            <if test="gameprofit != null">#{gameprofit},</if>
            <if test="plampfit != null">#{plampfit},</if>
            <if test="bili != null">#{bili},</if>
            <if test="begindate != null">#{begindate},</if>
        </trim>
    </insert>

    <update id="updateReportPlamGameschilds" parameterType="ReportPlamGameschilds">
        update report_plam_gameschilds
        <trim prefix="SET" suffixOverrides=",">
            <if test="gameagent != null">gameagent = #{gameagent},</if>

            <if test="gameplame != null">gameplame = #{gameplame},</if>

            <if test="agentchild != null">agentchild = #{agentchild},</if>

