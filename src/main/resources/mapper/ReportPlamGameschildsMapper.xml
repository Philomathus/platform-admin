<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.ReportPlamGameschildsMapper">

    <resultMap type="ReportPlamGameschilds" id="ReportPlamGameschildsResult">
        <result property="gameUuid" column="game_uuid" />
        <result property="gameagent" column="gameagent" />
        <result property="gameplame" column="gameplame" />
        <result property="agentchild" column="agentchild" />
        <result property="agentchildname" column="agentchildname" />
        <result property="gamepepole" column="gamepepole" />
        <result property="gametouzhu" column="gametouzhu" />
        <result property="gamecell" column="gamecell" />
        <result property="gamebet" column="gamebet" />
        <result property="gamerevenve" column="gamerevenve" />
        <result property="gameprofit" column="gameprofit" />
        <result property="plampfit" column="plampfit" />
        <result property="bili" column="bili" />
        <result property="begindate" column="begindate" />
    </resultMap>

    <sql id="selectReportPlamGameschildsVo">
        select game_uuid,
        gameagent,
        gameplame,
        agentchild,
        agentchildname,
        gamepepole,
        gametouzhu,
        gamecell,
        gamebet,
        gamerevenve,
        gameprofit,
        plampfit,
        bili,
        <choose>
            <when test="endDate != null">
                CONCAT( #{begindate}, ' - ', #{endDate} ) as begindate
            </when>
            <otherwise>
                begindate
            </otherwise>
        </choose>
        from report_plam_gameschilds
    </sql>

    <select id="selectReportPlamGameschildsList" parameterType="ReportPlamGameschilds"
            resultMap="ReportPlamGameschildsResult">
        select
        gameagent,
        gameplame,
        agentchild,
        agentchildname,
        sum(gamepepole) as gamepepole,
        sum(gametouzhu) as gametouzhu,
        sum(gamecell) as gamecell,
        sum(gamebet) as gamebet,
        sum(gameprofit) as gameprofit,
        CONCAT(ROUND(convert(sum(gameprofit),decimal(10,2)) / convert(sum(gamecell),decimal(10,2)) * 100,2),'%') as
        bili,
        <choose>
            <when test="endDate != null">
                CONCAT( #{begindate}, ' - ', #{endDate} ) as begindate
            </when>
            <otherwise>
                begindate
            </otherwise>
        </choose>
        from report_plam_gameschilds
        <where>
            <if test="gameagent != null  and gameagent != ''">
                and gameagent = #{gameagent}
            </if>
            <if test="gameplame != null  and gameplame != ''">
                and gameplame = #{gameplame}
            </if>
            <if test="agentchild != null  and agentchild != ''">
                and agentchild = #{agentchild}
            </if>
            <if test="agentchildname != null  and agentchildname != ''">
                and agentchildname like concat('%', #{agentchildname}, '%')
            </if>
            <if test="gamepepole != null">
                and gamepepole = #{gamepepole}
            </if>
            <if test="gametouzhu != null">
                and gametouzhu = #{gametouzhu}
            </if>
            <if test="gamecell != null">
                and gamecell = #{gamecell}
            </if>
            <if test="gamebet != null">
                and gamebet = #{gamebet}
            </if>
            <if test="gamerevenve != null">
                and gamerevenve = #{gamerevenve}
            </if>
            <if test="gameprofit != null">
                and gameprofit = #{gameprofit}
            </if>
            <if test="plampfit != null">
                and plampfit = #{plampfit}
            </if>
            <if test="bili != null  and bili != ''">
                and bili = #{bili}
            </if>
            <if test="begindate != null and begindate != ''">
                and begindate <![CDATA[ >= ]]> #{begindate}
            </if>
            <if test="endDate != null and endDate != ''">
                and begindate <![CDATA[ <= ]]> #{endDate}
            </if>
        </where>
        GROUP BY gameagent, gameplame, agentchild, agentchildname
    </select>

    <select id="selectReportPlamGameschildsById" parameterType="String" resultMap="ReportPlamGameschildsResult">
        <include refid="selectReportPlamGameschildsVo" />
