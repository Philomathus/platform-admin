<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LotteryDiceConfigMapper">

    <resultMap type="LotteryDiceConfig" id="LotteryDiceConfigResult">
        <result property="id"    column="id"    />
        <result property="depositTotalMin"    column="deposit_total_min"    />
        <result property="depositTotalMax"    column="deposit_total_max"    />
        <result property="lotteryTimes"    column="lottery_times"    />
        <result property="status"    column="status"    />
        <result property="type"    column="type"    />
    </resultMap>

    <sql id="selectLotteryDiceConfigVo">
        select id, deposit_total_min, deposit_total_max, lottery_times, status, type from ${dbMain}.lottery_dice_config
    </sql>

    <select id="selectLotteryDiceConfigList" parameterType="LotteryDiceConfig" resultMap="LotteryDiceConfigResult">
        <include refid="selectLotteryDiceConfigVo"/>
        <where>
            <if test="depositTotalMin != null "> and deposit_total_min = #{depositTotalMin}</if>
            <if test="depositTotalMax != null "> and deposit_total_max = #{depositTotalMax}</if>
            <if test="lotteryTimes != null "> and lottery_times = #{lotteryTimes}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="type != null "> and type = #{type}</if>
        </where>
    </select>

    <select id="selectLotteryDiceConfigById" parameterType="Long" resultMap="LotteryDiceConfigResult">
        <include refid="selectLotteryDiceConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertLotteryDiceConfig" parameterType="LotteryDiceConfig" useGeneratedKeys="true" keyProperty="id">
        insert into ${dbMain}.lottery_dice_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="depositTotalMin != null">deposit_total_min,</if>
            <if test="depositTotalMax != null">deposit_total_max,</if>
            <if test="lotteryTimes != null">lottery_times,</if>
            <if test="status != null">status,</if>
            <if test="type != null">type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="depositTotalMin != null">#{depositTotalMin},</if>
                    <if test="depositTotalMax != null">#{depositTotalMax},</if>
                    <if test="lotteryTimes != null">#{lotteryTimes},</if>
                    <if test="status != null">#{status},</if>
                    <if test="type != null">#{type},</if>
             </trim>
    </insert>

    <update id="updateLotteryDiceConfig" parameterType="LotteryDiceConfig">
        update ${dbMain}.lottery_dice_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="depositTotalMin != null">deposit_total_min = #{depositTotalMin},</if>
    
            <if test="depositTotalMax != null">deposit_total_max = #{depositTotalMax},</if>
    
            <if test="lotteryTimes != null">lottery_times = #{lotteryTimes},</if>
    
            <if test="status != null">status = #{status},</if>
    
            <if test="type != null">type = #{type},</if>
    
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLotteryDiceConfigById" parameterType="Long">
        delete from ${dbMain}.lottery_dice_config where id = #{id}
    </delete>

    <delete id="deleteLotteryDiceConfigByIds" parameterType="String">
        delete from ${dbMain}.lottery_dice_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectWheelDiceBycash" resultType="java.lang.Integer">
        select lottery_times from ${dbMain}.lottery_dice_config
        where status =1 and type =1 and deposit_total_min <![CDATA[ <= ]]> #{cash}
        and deposit_total_max > #{cash}
    </select>
</mapper>
