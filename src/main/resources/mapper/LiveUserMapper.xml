    <sql id="selectLiveUserVo">
        select u.id,u.roboter,g.live_in,u.nick_name,u.weixin_price,u.weibo_money,u.family_chieftain,FROM_UNIXTIME(u.update_time) update_time,
		is_authentication,login_ip,focus_count,mobile,authentication_type,authentication_name,identify_hold_image,
		identify_positive_image,identify_nagative_image, u.fans_count, ticket, refund_ticket,is_ban,v_explain,family_id,
		coin,ticket_catty_ratio,open_pay,ban_remark,identify_number,login_time,logout_time,f.name family_name,
        f.user_id family_user_id,f.nick_name family_nick_name,u.qq_id,u.qq_token,u.xpoint,u.ypoint,u.weixin_account, user_pwd
		from ${dbLive}.live_user u left join ${dbLive}.live_family f on (f.id = u.family_id)
		left join ${dbLive}.live_video g on (u.id = g.user_id)
    </sql>

    <select id="selectLiveUserList" parameterType="LiveUser" resultMap="LiveUserResult">
        <include refid="selectLiveUserVo"/>
        <where>
            <if test="id != null and id != ''">
                and u.id = #{id}
            </if>
            <if test="nickName != null  and nickName != ''"> and u.nick_name like concat('%', #{nickName}, '%')</if>
            <if test="isAuthentication != null "> and is_authentication = #{isAuthentication}</if>
            <if test="loginIp != null  and loginIp != ''"> and login_ip = #{loginIp}</if>
            <if test="mobile != null  and mobile != ''"> and mobile = #{mobile}</if>
            <if test="fansCount != null "> and fans_count = #{fansCount}</if>
            <if test="isBan != null "> and is_ban = #{isBan}</if>
            <if test="identifyNumber != null  and identifyNumber != ''"> and identify_number = #{identifyNumber}</if>
            <if test="familyId != null "> and family_id = #{familyId}</if>
            <if test="coin != null "> and coin = #{coin}</if>
            <if test="openPay != null "> and open_pay = #{openPay}</if>
            <if test="virtualAnchor == 1"> and user_pwd is not null and user_pwd != '' and user_pwd REGEXP '^[0-9]+$'</if>
            <if test="virtualAnchor == 0"> and (user_pwd is null or user_pwd = '' or user_pwd not REGEXP '^[0-9]+$')</if>
            <if test="userIdSet != null and userIdSet.size() != 0">
                and u.id in
                <foreach item="userId" collection="userIdSet" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectLiveUserById" parameterType="Long" resultMap="LiveUserResult">
        <include refid="selectLiveUserVo"/>
        where u.id = #{id}
    </select>

    <insert id="insertLiveUser" parameterType="LiveUser">
        insert into ${dbLive}.live_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null and id != ''">id,</if>
            <if test="nickName != null and nickName != ''">nick_name,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="isAuthentication != null">is_authentication,</if>
            <if test="loginIp != null">login_ip,</if>
            <if test="focusCount != null">focus_count,</if>
            <if test="mobile != null and mobile != ''">mobile,</if>
            <if test="headImage != null and headImage != ''">head_image,</if>
            <if test="authenticationType != null">authentication_type,</if>
            <if test="authenticationName != null">authentication_name,</if>
            <if test="identifyHoldImage != null">identify_hold_image,</if>
            <if test="identifyPositiveImage != null">identify_positive_image,</if>
            <if test="identifyNagativeImage != null">identify_nagative_image,</if>
            <if test="investorSendInfo != null">investor_send_info,</if>
            <if test="vExplain != null">v_explain,</if>
            <if test="fansCount != null">fans_count,</if>
            <if test="ticket != null">ticket,</if>
            <if test="roboter != null">roboter,</if>
            <if test="refundTicket != null">refund_ticket,</if>
            <if test="isBan != null">is_ban,</if>
            <if test="identifyNumber != null">identify_number,</if>
            <if test="familyId != null">family_id,</if>
            <if test="coin != null">coin,</if>
            <if test="ticketCattyRatio != null">ticket_catty_ratio,</if>
            <if test="openPay != null">open_pay,</if>
            <if test="banRemark != null">ban_remark,</if>
            <if test="familyChieftain != null">family_chieftain,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null and id != ''">#{id},</if>
            <if test="nickName != null and nickName != ''">#{nickName},</if>
			<if test="updateTime != null">UNIX_TIMESTAMP(#{updateTime}),</if>
            <if test="createTime != null">UNIX_TIMESTAMP(#{createTime}),</if>
			<if test="isAuthentication != null">#{isAuthentication},</if>
			<if test="loginIp != null">#{loginIp},</if>
			<if test="focusCount != null">#{focusCount},</if>
            <if test="vExplain != null">#{vExplain},</if>
			<if test="mobile != null and mobile != ''">#{mobile},</if>
            <if test="headImage != null and headImage != ''">#{headImage},</if>
			<if test="authenticationType != null">#{authenticationType},</if>
			<if test="authenticationName != null">#{authenticationName},</if>
			<if test="identifyHoldImage != null">#{identifyHoldImage},</if>
			<if test="identifyPositiveImage != null">#{identifyPositiveImage},</if>
			<if test="identifyNagativeImage != null">#{identifyNagativeImage},</if>
			<if test="investorSendInfo != null">#{investorSendInfo},</if>
			<if test="fansCount != null">#{fansCount},</if>
			<if test="ticket != null">#{ticket},</if>
            <if test="roboter != null">#{roboter},</if>
			<if test="refundTicket != null">#{refundTicket},</if>
			<if test="isBan != null">#{isBan},</if>
			<if test="identifyNumber != null">#{identifyNumber},</if>
			<if test="familyId != null">#{familyId},</if>
			<if test="coin != null">#{coin},</if>
			<if test="ticketCattyRatio != null and ticketCattyRatio != ''">#{ticketCattyRatio},</if>
			<if test="openPay != null">#{openPay},</if>
			<if test="banRemark != null">#{banRemark},</if>
            <if test="familyChieftain != null">#{familyChieftain},</if>
         </trim>
    </insert>

    <update id="updateLiveUser" parameterType="LiveUser">
        update ${dbLive}.live_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="nickName != null and nickName != ''">nick_name = #{nickName},</if>
            <if test="updateTime != null">update_time = UNIX_TIMESTAMP(#{updateTime}),</if>
            <if test="isAuthentication != null">is_authentication = #{isAuthentication},</if>
            <if test="loginIp != null">login_ip = #{loginIp},</if>
            <if test="paypassword != null and paypassword != ''">paypassword = #{paypassword},</if>
            <if test="focusCount != null">focus_count = #{focusCount},</if>
            <if test="mobile != null and mobile != ''">mobile = #{mobile},</if>
            <if test="userPass != null and userPass != ''"> user_pwd = #{userPass},</if>
            <if test="authenticationType != null">authentication_type = #{authenticationType},</if>
            <if test="authenticationName != null">authentication_name = #{authenticationName},</if>
            <if test="identifyHoldImage != null">identify_hold_image = #{identifyHoldImage},</if>
            <if test="identifyPositiveImage != null">identify_positive_image = #{identifyPositiveImage},</if>
            <if test="identifyNagativeImage != null">identify_nagative_image = #{identifyNagativeImage},</if>
            <if test="investorSendInfo != null">investor_send_info = #{investorSendInfo},</if>
            <if test="vExplain != null">v_explain = #{vExplain},</if>
            <if test="fansCount != null">fans_count = #{fansCount},</if>
            <if test="ticket != null">ticket = #{ticket},</if>
            <if test="refundTicket != null">refund_ticket = #{refundTicket},</if>
            <if test="isBan != null">is_ban = #{isBan},</if>
            <if test="identifyNumber != null">identify_number = #{identifyNumber},</if>
            <if test="familyId != null">family_id = #{familyId},</if>
            <if test="expiryAfter != null">expiry_after = #{expiryAfter},</if>
            <if test="coin != null">coin = #{coin},</if>
            <if test="xpoint != null">xpoint = #{xpoint},</if>
            <if test="ypoint != null">ypoint = #{ypoint},</if>
            <if test="ticketCattyRatio != null">ticket_catty_ratio = #{ticketCattyRatio},</if>
            <if test="openPay != null">open_pay = #{openPay},</if>
            <if test="banRemark != null">ban_remark = #{banRemark},</if>
