        <result property="identifyPositiveImage"    column="identify_positive_image"    />
        <result property="identifyNagativeImage"    column="identify_nagative_image"    />
        <result property="vExplain"    column="v_explain"    />
        <result property="fansCount"    column="fans_count"    />
        <result property="ticket"    column="ticket"    />
        <result property="refundTicket"    column="refund_ticket"    />
        <result property="isBan"    column="is_ban"    />
        <result property="identifyNumber"    column="identify_number"    />
        <result property="familyId"    column="family_id"    />
        <result property="roboter"    column="roboter"    />
        <result property="familyName"    column="family_name"    />
