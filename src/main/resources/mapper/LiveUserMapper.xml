        </trim>
        where id = #{id}
    </update>

    <select id="selectAnchorAward" resultType="com.qiqilm.server.admin.domain.rsp.RspLotteryBet">
        select host_id as anchor, prize, cost, create_date as updateTime, cost_qianliu prizeSixThousand,
        host_nickname as nickName from ${dbLive}.live_host_paijiang
        <where>
            <if test="id != null  and id != ''"> and host_id = #{id}</if>
            <if test="nickName != null  and nickName != ''"> and host_nickname like concat('%', #{nickName}, '%')</if>
            <if test="updateTime != null  and updateTime != ''"> and create_date = #{updateTime}</if>
        </where>
    </select>

   <update id="updateLiveUserByFamilyId" parameterType="integer">
       UPDATE ${dbLive}.live_user SET family_id = 0 where family_id = #{familyId}
   </update>

    <update id="updateTicket">
        UPDATE ${dbLive}.live_user SET ticket = #{ticket} where id = #{userId}
    </update>

    <update id="updateLiveUserIsBanStopByFamilyId">
        UPDATE ${dbLive}.live_user SET is_ban = 1, ban_remark = #{remark} where family_id = #{familyId}
    </update>

    <update id="updateLiveUserIsBanKeepByFamilyId">
        UPDATE ${dbLive}.live_user SET is_ban = 0, ban_remark = #{remark} where family_id = #{familyId}
    </update>
    <select id="selectLiveUsersByMobile" resultMap="LiveUserResult">
        <include refid="selectLiveUserVo"/>
        <where>
            mobile = #{mobile}
        </where>
    </select>
    <select id="checkMobile" resultType="java.lang.Integer">
        select count(*)
		from ${dbLive}.live_user where mobile = #{newMobile}
    </select>
    <select id="selectLiveUserBankById" resultType="com.qiqilm.server.admin.domain.LiveUser">
        select id,real_name realName,bank_account bankAccount,bank_address bankName from
        ${dbLive}.live_user_bank where user_id = #{userId}
    </select>

    <update id="updateLiveUserBank" parameterType="LiveUser">
        update ${dbLive}.live_user_bank
        <trim prefix="SET" suffixOverrides=",">
            <if test="realName != null">real_name = #{realName},</if>

            <if test="bankAccount != null">bank_account = #{bankAccount},</if>

            <if test="bankName != null">bank_address = #{bankName},</if>
            <if test="bankTypeId != null">bank_type_id = #{bankTypeId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="delLiveUserBankById">
        delete from ${dbLive}.live_user_bank where bank_account = #{bankAccount}
    </delete>

    <select id="selectFirstId" resultType="java.lang.Long">
        select id from ${dbLive}.live_user order by id asc limit 1
    </select>

    <select id="selectLiveUserInId" resultMap="LiveUserResult">
        select id,nick_name, open_pay from ${dbLive}.live_user where id in
        <foreach collection="array" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>

    <select id="selectMobileById" parameterType="String" resultMap="LiveUserResult">
        select mobile from ${dbLive}.live_user
        where id = #{id}
    </select>

    <select id="selectLiveUserAuthList" parameterType="LiveUser" resultMap="LiveUserResult">
        select is_authentication from ${dbLive}.live_user
    </select>

</mapper>
