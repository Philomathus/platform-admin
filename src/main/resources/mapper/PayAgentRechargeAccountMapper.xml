    </update>

    <delete id="deletePayAgentRechargeAccountById" parameterType="Long">
        delete from pay_agent_recharge_account where id = #{id}
    </delete>

    <delete id="deletePayAgentRechargeAccountByIds" parameterType="String">
        delete from pay_agent_recharge_account where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="memberIdSearchRepeat" resultType="java.lang.Integer">
        select count(0) from pay_agent_recharge_account
        where account = #{account}
    </select>
    <update id="updateGoogle">
        update pay_agent_recharge_account set google_auth_secret = #{googleAuthSecret} where id=#{id}
    </update>
    <update id="updatePassword">
        update ${dbOim}.w_user set password = #{password} where id=#{id}
    </update>
    <select id="selectPayAgentRechargeAccount" parameterType="String"  resultMap="PayAgentRechargeAccountResult">
