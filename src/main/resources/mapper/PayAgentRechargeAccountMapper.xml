            <if test="alipayAccount != null">alipay_account = #{alipayAccount},</if>
            <if test="mobile != null and mobile != ''">mobile = #{mobile},</if>
            <if test="businessBeginTime != null">business_begin_time = #{businessBeginTime},</if>
            <if test="businessEndTime != null">business_end_time = #{businessEndTime},</if>
            <if test="rechargeDiscountRate != null">recharge_discount_rate = #{rechargeDiscountRate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="showStatus != null">show_status = #{showStatus},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="beforeLoginTime != null">before_login_time = #{beforeLoginTime},</if>
            <if test="loginTime != null">login_time = #{loginTime},</if>
        </trim>
