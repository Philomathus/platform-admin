<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveOfficerMapper">

    <resultMap type="LiveOfficer" id="LiveOfficerResult">
        <result property="id"    column="id"    />
        <result property="hostId"    column="host_id"    />
        <result property="puserId"    column="p_user_id"    />
        <result property="ctime"    column="c_time"    />
        <result property="hostName"    column="host_name"    />
    </resultMap>

    <sql id="selectLiveOfficerVo">
        select o.id, o.host_id, o.p_user_id, o.c_time, u.nick_name host_name
        from ${dbLive}.live_officer o left join ${dbLive}.live_user u on u.id = o.host_id
    </sql>

    <select id="selectLiveOfficerList" parameterType="LiveOfficer" resultMap="LiveOfficerResult">
        <include refid="selectLiveOfficerVo"/>
        <where>
            <if test="type != null"> and o.type = #{type}</if>
            <if test="hostId != null "> and o.host_id = #{hostId}</if>
            <if test="puserId != null  and puserId != ''"> and o.p_user_id = #{puserId}</if>
        </where>
        order by c_time desc
    </select>

    <select id="selectLiveOfficerById" parameterType="String" resultMap="LiveOfficerResult">
        <include refid="selectLiveOfficerVo"/>
        where id = #{id}
    </select>
    <select id="countId" resultType="java.lang.Integer">
        select count(1) from ${dbLive}.live_officer where id=#{id}
    </select>

    <insert id="insertLiveOfficer" parameterType="LiveOfficer">
        insert into ${dbLive}.live_officer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="type != null">type,</if>
            <if test="hostId != null">host_id,</if>
            <if test="puserId != null">p_user_id,</if>
            <if test="ctime != null">c_time,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="type != null">#{type},</if>
            <if test="hostId != null">#{hostId},</if>
            <if test="puserId != null">#{puserId},</if>
            <if test="ctime != null">#{ctime},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <delete id="deleteLiveOfficerById" parameterType="String">
        delete from ${dbLive}.live_officer where id = #{id}
    </delete>

    <delete id="deleteLiveOfficerByIds" parameterType="String">
        delete from ${dbLive}.live_officer where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>