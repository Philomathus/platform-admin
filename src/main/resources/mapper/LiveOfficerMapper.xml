<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveOfficerMapper">

    <resultMap type="LiveOfficer" id="LiveOfficerResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="hostId"    column="host_id"    />
        <result property="puserId"    column="p_user_id"    />
        <result property="cTime"    column="c_time"    />
        <result property="status"    column="status"    />
        <result property="hostName"    column="host_name"    />
        <result property="pUserName"    column="p_user_name"    />
    </resultMap>

    <sql id="selectLiveOfficerVo">
        select o.id, o.type, o.host_id, o.p_user_id, o.c_time, o.status, u.nick_name host_name, m.nick_name p_user_name
        from ${dbLive}.live_officer o
            left join ${dbLive}.live_user u on u.id = o.host_id
            left join ${dbMain}.member_info m on m.id = o.p_user_id
    </sql>

    <select id="selectLiveOfficerList" parameterType="LiveOfficer" resultMap="LiveOfficerResult">
        <include refid="selectLiveOfficerVo"/>
        <where>
            <if test="type != null "> and type = #{type}</if>
            <if test="hostId != null "> and host_id = #{hostId}</if>
            <if test="puserId != null  and puserId != ''"> and p_user_id = #{puserId}</if>
            <if test="cTime != null "> and c_time = #{cTime}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by c_time desc
    </select>

    <select id="selectLiveOfficerById" parameterType="String" resultMap="LiveOfficerResult">
        <include refid="selectLiveOfficerVo"/>
        where id = #{id}
    </select>

    <insert id="insertLiveOfficer" parameterType="LiveOfficer">
        insert into live_officer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="type != null">type,</if>
            <if test="hostId != null">host_id,</if>
            <if test="puserId != null">p_user_id,</if>
            <if test="cTime != null">c_time,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="type != null">#{type},</if>
            <if test="hostId != null">#{hostId},</if>
            <if test="puserId != null">#{puserId},</if>
            <if test="cTime != null">#{cTime},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <update id="updateLiveOfficer" parameterType="LiveOfficer">
        update live_officer
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="hostId != null">host_id = #{hostId},</if>
            <if test="puserId != null">p_user_id = #{puserId},</if>
            <if test="cTime != null">c_time = #{cTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLiveOfficerById" parameterType="String">
        delete from live_officer where id = #{id}
    </delete>

    <delete id="deleteLiveOfficerByIds" parameterType="String">
        delete from live_officer where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>