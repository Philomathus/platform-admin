<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiqilm.server.admin.mapper.LiveComplaintMapper">

    <resultMap type="LiveComplaint" id="LiveComplaintResult">
        <result property="id"    column="id"    />
        <result property="content"    column="content"    />
        <result property="userId"    column="user_id"    />
        <result property="anchor"    column="anchor"    />
        <result property="anchorNick"    column="anchor_nick"    />
        <result property="roomName"    column="room_name"    />
        <result property="mobile"    column="mobile"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectLiveComplaintVo">
        SELECT id, content, user_id,mobile,room_name,anchor_nick, anchor, create_time FROM ${dbLive}.live_complaint
    </sql>

    <select id="selectLiveComplaintList" parameterType="LiveComplaint" resultMap="LiveComplaintResult">
        <include refid="selectLiveComplaintVo"/>
        <where>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="anchor != null  and anchor != ''"> and anchor = #{anchor}</if>
        </where>
    </select>
